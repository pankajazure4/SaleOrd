@model IEnumerable<SaleOrd.Models.Domain.Ledger>
@{
    ViewData["Title"] = "Parties";
    ViewData["ActivePage"] = "Parties";
}

<div class="page-header">
    <h5>Parties</h5>
    <div class="page-title-sub">@ViewBag.TotalCount parties</div>
</div>

<form method="get" class="mb-3" id="mastersSearchForm">
    <div class="input-group">
        <input type="text" name="q" value="@ViewBag.Q" class="form-control"
               id="mastersSearchInput"
               placeholder="Search name or mobile..." autocomplete="off" />
        @if (!string.IsNullOrEmpty(ViewBag.Q as string))
        {
            <a href="/Masters/Parties" class="btn btn-outline-danger" title="Clear">
                <i class="bi bi-x"></i>
            </a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-people" style="font-size:40px;opacity:.25"></i>
        <p class="mt-3 fw-semibold">No parties found</p>
        @if (string.IsNullOrEmpty(ViewBag.Q as string))
        {
            <p class="small">Sync from Tally first — click the <strong>Sync</strong> button on Dashboard.</p>
        }
        else
        {
            <p class="small">No results for "<strong>@ViewBag.Q</strong>"</p>
        }
    </div>
}
else
{
    <div class="list-group">
    @foreach (var p in Model)
    {
        <div class="list-group-item py-2 px-3 border-0 border-bottom">
            <div class="d-flex justify-content-between align-items-start">
                <div style="min-width:0">
                    <div class="fw-semibold text-truncate">@p.LedgerName</div>
                    <div class="text-muted" style="font-size:11px">
                        @p.Parent
                        @if (!string.IsNullOrEmpty(p.MobileNo))
                        {
                            <span class="ms-2"><i class="bi bi-telephone"></i> @p.MobileNo</span>
                        }
                        @if (!string.IsNullOrEmpty(p.GSTNo))
                        {
                            <span class="ms-2 text-success"><i class="bi bi-shield-check"></i> @p.GSTNo</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(p.Address))
                    {
                        <div class="text-muted" style="font-size:11px"><i class="bi bi-geo-alt"></i> @p.Address@(!string.IsNullOrEmpty(p.State) ? ", " + p.State : "")</div>
                    }
                </div>
                <div class="text-end ms-2 flex-shrink-0">
                    @{
                        bool isCr = p.ClosingBalance < 0;
                        string balClass = isCr ? "text-danger" : "text-success";
                    }
                    <div class="fw-semibold small @balClass">
                        ₹@Math.Abs(p.ClosingBalance).ToString("N0")
                        <span style="font-size:10px">@(isCr ? "Cr" : "Dr")</span>
                    </div>
                    @if (p.CreditLimit > 0)
                    {
                        <div class="text-muted" style="font-size:10px">Limit ₹@p.CreditLimit.ToString("N0")</div>
                    }
                </div>
            </div>
        </div>
    }
    </div>
    <div class="text-muted small text-center mt-2">Showing @Model.Count() of @ViewBag.TotalCount parties</div>
}

@section Scripts {
<script>
    (function () {
        var timer;
        $('#mastersSearchInput').on('input', function () {
            clearTimeout(timer);
            var form = this.form;
            timer = setTimeout(function () { form.submit(); }, 250);
        });
    })();
</script>
}
