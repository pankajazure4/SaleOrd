@model IEnumerable<SaleOrd.Models.Domain.Ledger>
@{
    ViewData["Title"] = "Parties";
    ViewData["ActivePage"] = "Parties";
}

<div class="page-header">
    <div>
        <h5>Parties</h5>
        <div class="page-title-sub">@ViewBag.TotalCount parties</div>
    </div>
    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#newPartyModal">
        <i class="bi bi-plus-lg me-1"></i>New Party
    </button>
</div>

<div class="mb-3">
    <div class="input-group">
        <button type="button" class="input-group-text bg-white border-end-0" style="cursor:pointer" onclick="doSearch($('#searchInput').val().trim())" title="Search">
            <i class="bi bi-search text-muted"></i>
        </button>
        <input type="text" id="searchInput" class="form-control border-start-0"
               placeholder="Search name or mobile..." autocomplete="off" autofocus />
        <button type="button" id="btnClear" class="btn btn-outline-secondary" style="display:none" onclick="clearSearch()">
            <i class="bi bi-x"></i>
        </button>
    </div>
    <div id="searchStatus" class="text-muted small mt-1 px-1"></div>
</div>

<div id="searchResults">
    <div class="text-center text-muted py-5">
        <i class="bi bi-search" style="font-size:40px;opacity:.2"></i>
        <p class="mt-3 fw-semibold">Type to search</p>
        <p class="small">Search by name or mobile number among @ViewBag.TotalCount parties</p>
    </div>
</div>

<div class="modal fade" id="newPartyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Party</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Party Name <span class="text-danger">*</span></label>
                    <input type="text" id="npName" class="form-control form-control-sm" placeholder="e.g. Aajo the Discount Shop" />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">GST Number</label>
                    <input type="text" id="npGst" class="form-control form-control-sm" placeholder="e.g. 27AKJPC3922G1ZE" />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Food License No. (FSSAI)</label>
                    <input type="text" id="npFssai" class="form-control form-control-sm" placeholder="Optional" />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Address</label>
                    <textarea id="npAddress" class="form-control form-control-sm" rows="2" placeholder="Optional"></textarea>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">State</label>
                        <select id="npState" class="form-select form-select-sm">
                            <option value="">Select State</option>
                            @foreach (var s in new[] {
                                "Andaman and Nicobar Islands","Andhra Pradesh","Arunachal Pradesh","Assam","Bihar",
                                "Chandigarh","Chhattisgarh","Dadra and Nagar Haveli and Daman and Diu","Delhi","Goa",
                                "Gujarat","Haryana","Himachal Pradesh","Jammu and Kashmir","Jharkhand","Karnataka",
                                "Kerala","Ladakh","Lakshadweep","Madhya Pradesh","Maharashtra","Manipur","Meghalaya",
                                "Mizoram","Nagaland","Odisha","Puducherry","Punjab","Rajasthan","Sikkim","Tamil Nadu",
                                "Telangana","Tripura","Uttar Pradesh","Uttarakhand","West Bengal"
                            })
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Country</label>
                        <select id="npCountry" class="form-select form-select-sm">
                            <option value="India" selected>India</option>
                        </select>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Contact Number</label>
                    <input type="text" id="npContact" class="form-control form-control-sm" placeholder="Optional" />
                </div>
                <div class="text-muted" style="font-size:11px">Saved locally and pushed to Tally immediately as a new party under "Sundry Debtors".</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnSaveParty" onclick="saveNewParty()">
                    <i class="bi bi-save me-1"></i>Save Party
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
var searchTimer;

$('#searchInput').on('input', function() {
    clearTimeout(searchTimer);
    var q = this.value.trim();
    $('#btnClear').toggle(q.length > 0);
    if (q.length === 0) { showEmptyState(); return; }
    showLoading();
    searchTimer = setTimeout(function() { doSearch(q); }, 280);
});

function doSearch(q) {
    $.get('/Masters/PartiesSearch', { q: q }, function(data) {
        renderParties(data, q);
    }).fail(function() {
        $('#searchResults').html('<div class="alert alert-danger">Search failed. Please try again.</div>');
    });
}

function renderParties(parties, q) {
    if (!parties.length) {
        $('#searchStatus').text('');
        $('#searchResults').html(
            '<div class="text-center text-muted py-5">' +
            '<i class="bi bi-people" style="font-size:36px;opacity:.25"></i>' +
            '<p class="mt-3 fw-semibold">No parties found</p>' +
            '<p class="small">No results for "<strong>' + escHtml(q) + '</strong>"</p></div>');
        return;
    }

    $('#searchStatus').text('Showing ' + parties.length + ' result' + (parties.length > 1 ? 's' : ''));
    var html = '<div class="list-group">';
    parties.forEach(function(p) {
        var isCr = p.closingBalance < 0;
        var balAbs = Math.abs(p.closingBalance);
        var balHtml = '<div class="fw-semibold small ' + (isCr ? 'text-danger' : 'text-success') + '">' +
            '₹' + balAbs.toLocaleString('en-IN', {maximumFractionDigits:0}) +
            ' <span style="font-size:10px">' + (isCr ? 'Cr' : 'Dr') + '</span></div>';

        var meta = escHtml(p.parent || '');
        if (p.mobileNo) meta += '<span class="ms-2"><i class="bi bi-telephone"></i> ' + escHtml(p.mobileNo) + '</span>';
        if (p.gstNo)    meta += '<span class="ms-2 text-success"><i class="bi bi-shield-check"></i> ' + escHtml(p.gstNo) + '</span>';

        html += '<div class="list-group-item py-2 px-3 border-0 border-bottom">' +
            '<div class="d-flex justify-content-between align-items-start">' +
            '<div style="min-width:0">' +
            '<div class="fw-semibold text-truncate">' + escHtml(p.ledgerName) + '</div>' +
            '<div class="text-muted" style="font-size:11px">' + meta + '</div>' +
            '</div>' +
            '<div class="text-end ms-2 flex-shrink-0">' + balHtml + '</div>' +
            '</div></div>';
    });
    html += '</div>';
    if (parties.length === 60) html += '<div class="text-muted small text-center mt-2 py-2">Showing top 60 — refine your search</div>';
    $('#searchResults').html(html);
}

function showEmptyState() {
    $('#searchStatus').text('');
    $('#searchResults').html(
        '<div class="text-center text-muted py-5">' +
        '<i class="bi bi-search" style="font-size:40px;opacity:.2"></i>' +
        '<p class="mt-3 fw-semibold">Type to search</p>' +
        '<p class="small">Search by name or mobile number among @ViewBag.TotalCount parties</p></div>');
}

function showLoading() {
    $('#searchStatus').text('');
    $('#searchResults').html('<div class="text-center py-4 text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Searching...</div>');
}

function clearSearch() {
    $('#searchInput').val('').focus();
    $('#btnClear').hide();
    showEmptyState();
}

function escHtml(s) { return $('<div>').text(s || '').html(); }

function saveNewParty() {
    var name = $('#npName').val().trim();
    if (!name) {
        showToast('danger', 'Party name is required.', 'Validation Error');
        return;
    }

    var $btn = $('#btnSaveParty');
    var originalHtml = $btn.html();
    $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');

    $.post('/Masters/CreateParty', {
        partyName: name,
        gstNo: $('#npGst').val().trim(),
        fssaiNo: $('#npFssai').val().trim(),
        address: $('#npAddress').val().trim(),
        state: $('#npState').val(),
        contactNo: $('#npContact').val().trim(),
        __RequestVerificationToken: $('#newPartyModal [name=__RequestVerificationToken]').val()
    }, function(r) {
        showToast(r.success ? (r.tallySynced ? 'success' : 'warning') : 'danger', r.message, r.success ? 'Party Saved' : 'Error');
        if (r.success) {
            bootstrap.Modal.getInstance(document.getElementById('newPartyModal')).hide();
            $('#npName, #npGst, #npFssai, #npAddress, #npContact').val('');
            $('#npState').val('');
            if ($('#searchInput').val().trim()) doSearch($('#searchInput').val().trim());
        }
    }).fail(function() {
        showToast('danger', 'Request failed. Please try again.', 'Error');
    }).always(function() {
        $btn.prop('disabled', false).html(originalHtml);
    });
}
</script>
}
