@model IEnumerable<SaleOrd.Models.Domain.StockItem>
@{
    ViewData["Title"] = "Stock Items";
    ViewData["ActivePage"] = "Items";
}

<div class="page-header">
    <h5>Stock Items</h5>
    <div class="page-title-sub">@ViewBag.TotalCount items</div>
</div>

<div class="mb-3">
    <div class="input-group">
        <button type="button" class="input-group-text bg-white border-end-0" style="cursor:pointer" onclick="doSearch($('#searchInput').val().trim())" title="Search">
            <i class="bi bi-search text-muted"></i>
        </button>
        <input type="text" id="searchInput" class="form-control border-start-0"
               placeholder="Search item name..." autocomplete="off" />
        <button type="button" id="btnClear" class="btn btn-outline-secondary" style="display:none" onclick="clearSearch()">
            <i class="bi bi-x"></i>
        </button>
    </div>
    <div id="searchStatus" class="text-muted small mt-1 px-1"></div>
</div>

<div id="searchResults">
    <div class="text-center text-muted py-5">
        <i class="bi bi-search" style="font-size:40px;opacity:.2"></i>
        <p class="mt-3 fw-semibold">Type to search</p>
        <p class="small">Enter a name to search among @ViewBag.TotalCount items</p>
    </div>
</div>

@section Scripts {
<script>
var searchTimer;

$('#searchInput').on('input', function() {
    clearTimeout(searchTimer);
    var q = this.value.trim();
    $('#btnClear').toggle(q.length > 0);
    if (q.length === 0) { showEmptyState(); return; }
    if (q.length < 1) { return; }
    showLoading();
    searchTimer = setTimeout(function() { doSearch(q); }, 280);
});

function doSearch(q) {
    $.get('/Masters/ItemsSearch', { q: q }, function(data) {
        renderItems(data, q);
    }).fail(function() {
        $('#searchResults').html('<div class="alert alert-danger">Search failed. Please try again.</div>');
    });
}

function renderItems(items, q) {
    if (!items.length) {
        $('#searchStatus').text('');
        $('#searchResults').html(
            '<div class="text-center text-muted py-5">' +
            '<i class="bi bi-box-seam" style="font-size:36px;opacity:.25"></i>' +
            '<p class="mt-3 fw-semibold">No items found</p>' +
            '<p class="small">No results for "<strong>' + escHtml(q) + '</strong>"</p></div>');
        return;
    }

    $('#searchStatus').text('Showing ' + items.length + ' result' + (items.length > 1 ? 's' : ''));
    var html = '<div class="list-group">';
    items.forEach(function(item) {
        var stock = item.closingBalance !== 0
            ? '<div class="fw-semibold small ' + (item.closingBalance > 0 ? 'text-success' : 'text-danger') + '">' + fmtNum(item.closingBalance) + ' ' + escHtml(item.uom) + '</div><div class="text-muted" style="font-size:10px">in stock</div>'
            : '<div class="text-muted small">—</div>';

        var meta = '';
        if (item.parent) meta += '<span class="me-2"><i class="bi bi-folder"></i> ' + escHtml(item.parent) + '</span>';
        meta += '<span class="badge bg-light text-dark border">' + escHtml(item.uom) + '</span>';
        if (item.additionalUnits) meta += '<span class="text-muted ms-1">/ ' + escHtml(item.additionalUnits) + '</span>';
        if (item.isBatchwiseOn) meta += '<span class="badge bg-info bg-opacity-10 text-info ms-1" style="font-size:10px">Batch</span>';

        html += '<div class="list-group-item py-2 px-3 border-0 border-bottom">' +
            '<div class="d-flex justify-content-between align-items-center">' +
            '<div style="min-width:0">' +
            '<div class="fw-semibold text-truncate">' + escHtml(item.itemName) + '</div>' +
            '<div class="text-muted" style="font-size:11px">' + meta + '</div>' +
            '</div>' +
            '<div class="text-end ms-2 flex-shrink-0">' + stock + '</div>' +
            '</div></div>';
    });
    html += '</div>';
    if (items.length === 60) html += '<div class="text-muted small text-center mt-2 py-2">Showing top 60 — refine your search for more specific results</div>';
    $('#searchResults').html(html);
}

function showEmptyState() {
    $('#searchStatus').text('');
    $('#searchResults').html(
        '<div class="text-center text-muted py-5">' +
        '<i class="bi bi-search" style="font-size:40px;opacity:.2"></i>' +
        '<p class="mt-3 fw-semibold">Type to search</p>' +
        '<p class="small">Enter a name to search among @ViewBag.TotalCount items</p></div>');
}

function showLoading() {
    $('#searchStatus').text('');
    $('#searchResults').html('<div class="text-center py-4 text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Searching...</div>');
}

function clearSearch() {
    $('#searchInput').val('').focus();
    $('#btnClear').hide();
    showEmptyState();
}

function escHtml(s) { return $('<div>').text(s || '').html(); }
function fmtNum(n) { return (n||0).toLocaleString('en-IN', {minimumFractionDigits:3, maximumFractionDigits:3}); }
</script>
}
