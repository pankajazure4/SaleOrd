@model IEnumerable<SaleOrd.Models.Domain.StockItem>
@{
    ViewData["Title"] = "Stock Items";
    ViewData["ActivePage"] = "Items";
}

<div class="page-header">
    <h5>Stock Items</h5>
    <div class="page-title-sub">@ViewBag.TotalCount items</div>
</div>

<form method="get" class="mb-3" id="mastersSearchForm">
    <div class="input-group">
        <input type="text" name="q" value="@ViewBag.Q" class="form-control"
               id="mastersSearchInput"
               placeholder="Search item name..." autocomplete="off" />
        @if (!string.IsNullOrEmpty(ViewBag.Q as string))
        {
            <a href="/Masters/Items" class="btn btn-outline-danger" title="Clear">
                <i class="bi bi-x"></i>
            </a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-box-seam" style="font-size:40px;opacity:.25"></i>
        <p class="mt-3 fw-semibold">No items found</p>
        @if (string.IsNullOrEmpty(ViewBag.Q as string))
        {
            <p class="small">Sync from Tally first — click the <strong>Sync</strong> button on Dashboard.</p>
        }
        else
        {
            <p class="small">No results for "<strong>@ViewBag.Q</strong>"</p>
        }
    </div>
}
else
{
    <div class="list-group">
    @foreach (var item in Model)
    {
        <div class="list-group-item py-2 px-3 border-0 border-bottom">
            <div class="d-flex justify-content-between align-items-center">
                <div style="min-width:0">
                    <div class="fw-semibold text-truncate">@item.ItemName</div>
                    <div class="text-muted" style="font-size:11px">
                        @if (!string.IsNullOrEmpty(item.Parent))
                        {
                            <span class="me-2"><i class="bi bi-folder"></i> @item.Parent</span>
                        }
                        <span class="badge bg-light text-dark border">@item.UOM</span>
                        @if (!string.IsNullOrEmpty(item.AdditionalUnits))
                        {
                            <span class="text-muted ms-1">/ @item.AdditionalUnits</span>
                        }
                        @if (item.IsBatchwiseOn)
                        {
                            <span class="badge bg-info bg-opacity-10 text-info ms-1" style="font-size:10px">Batch</span>
                        }
                    </div>
                </div>
                <div class="text-end ms-2 flex-shrink-0">
                    @if (item.ClosingBalance != 0)
                    {
                        <div class="fw-semibold small @(item.ClosingBalance > 0 ? "text-success" : "text-danger")">
                            @item.ClosingBalance.ToString("N3") @item.UOM
                        </div>
                        <div class="text-muted" style="font-size:10px">in stock</div>
                    }
                    else
                    {
                        <div class="text-muted small">—</div>
                    }
                </div>
            </div>
        </div>
    }
    </div>
    <div class="text-muted small text-center mt-2">Showing @Model.Count() of @ViewBag.TotalCount items</div>
}

@section Scripts {
<script>
    (function () {
        var timer;
        $('#mastersSearchInput').on('input', function () {
            clearTimeout(timer);
            var form = this.form;
            timer = setTimeout(function () { form.submit(); }, 250);
        });
    })();
</script>
}
