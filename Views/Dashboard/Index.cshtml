@{ ViewData["Title"] = "Dashboard"; ViewData["ActivePage"] = "Dashboard"; }
@{
    var stats = ViewBag.Stats;
    var recentOrders = ViewBag.RecentOrders as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var syncInfo = ViewBag.SyncInfo;
}

<div class="page-header">
    <div>
        <h5>Dashboard</h5>
        <div class="page-title-sub">Welcome back, @ViewBag.UserName</div>
    </div>
    <div class="d-flex gap-2">
        @if ((string)ViewBag.Role == "Admin" && !(bool)ViewBag.IsAgentManaged)
        {
            <button class="btn btn-outline-secondary btn-sm" id="syncBtn" onclick="triggerSync()" title="Sync data from Tally">
                <i class="bi bi-arrow-repeat" id="syncIcon"></i>
                <span class="d-none d-md-inline ms-1">Sync</span>
            </button>
        }
        <a href="/SaleOrder/Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>New Order
        </a>
    </div>
</div>

<div id="syncMsg" class="alert py-2 small mb-3" style="display:none"></div>

<!-- ── Stat cards ── -->
@if (stats != null)
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card stat-card stat-blue p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-val text-primary" id="statToday">@stats.TodayCount</div>
                        <div class="stat-label">Today's Orders</div>
                    </div>
                    <div class="stat-icon icon-blue"><i class="bi bi-calendar-check"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card stat-orange p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-val" style="color:var(--warning)" id="statPending">@stats.Pending</div>
                        <div class="stat-label">Pending Sync</div>
                    </div>
                    <div class="stat-icon icon-orange"><i class="bi bi-clock-history"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card stat-green p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-val" style="color:var(--success)" id="statSynced">@stats.Synced</div>
                        <div class="stat-label">Synced to Tally</div>
                    </div>
                    <div class="stat-icon icon-green"><i class="bi bi-check-circle"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card stat-indigo p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-val" style="color:#3730a3" id="statInvoiced">@stats.Invoiced</div>
                        <div class="stat-label">Invoiced in Tally</div>
                    </div>
                    <div class="stat-icon icon-indigo"><i class="bi bi-receipt"></i></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card stat-red p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-val" style="color:var(--danger)" id="statError">@stats.Error</div>
                        <div class="stat-label">Sync Errors</div>
                    </div>
                    <div class="stat-icon icon-red"><i class="bi bi-exclamation-triangle"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-4">
            <div class="card stat-card stat-purple p-3">
                <div class="stat-label">This Month</div>
                <div class="stat-val" style="color:#7209b7" id="statMonthValue">₹@(((decimal)stats.MonthValue).ToString("N0"))</div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="card stat-card stat-teal p-3">
                <div class="stat-label">Total Orders</div>
                <div class="stat-val" style="color:#00838f" id="statTotal">@stats.Total</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card p-3 h-100">
                <div class="stat-label mb-2">Total Value (All Time)</div>
                <div class="stat-val text-primary" id="statTotalValue">₹@(((decimal)stats.TotalValue).ToString("N0"))</div>
            </div>
        </div>
    </div>
}

<!-- ── Main grid (desktop 2-col) ── -->
<div class="row g-3">
    <!-- Recent orders (left/full) -->
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Recent Orders</span>
                <a href="/SaleOrder" class="btn btn-sm btn-outline-primary" style="font-size:11px">View all</a>
            </div>
            <div class="p-2" id="recentOrdersList">
                @foreach (var o in recentOrders)
                {
                    string statusLabel = o.Status == SaleOrd.Models.Domain.OrderStatus.Synced && o.IsInvoiced ? "Invoiced" : o.Status.ToString();
                    string sc = statusLabel switch { "Pending" => "badge-pending", "Synced" => "badge-synced", "Invoiced" => "badge-invoiced", "Error" => "badge-error", _ => "badge-cancelled" };
                    <a href="/SaleOrder/Details/@o.SaleOrderId" class="text-decoration-none">
                        <div class="order-card card px-3 py-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <div style="min-width:0">
                                    <div class="fw-semibold text-truncate" style="font-size:13px">@o.LedgerName</div>
                                    <div class="text-muted" style="font-size:11px">@o.OrderNo · @(((DateTime)o.OrderDate).ToString("dd MMM"))</div>
                                </div>
                                <div class="text-end ms-2 flex-shrink-0">
                                    <div class="fw-bold" style="font-size:13px">₹@(((decimal)o.TotalAmount).ToString("N0"))</div>
                                    <span class="badge @sc" style="font-size:.65rem">@statusLabel</span>
                                </div>
                            </div>
                        </div>
                    </a>
                }
                @if (!recentOrders.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox" style="font-size:32px;opacity:.4"></i>
                        <p class="mt-2 small">No orders yet. <a href="/SaleOrder/Create">Create first order</a></p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right column -->
    <div class="col-lg-5">
        @{ var errorCount = stats == null ? 0 : (int)stats.Error; }
        <div class="card border-danger" id="errorAlertCard" style="border-color:var(--danger)!important; display:@(errorCount > 0 ? "block" : "none")">
            <div class="card-header text-danger d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span id="errorAlertText">@errorCount order(s) failed to sync</span>
            </div>
            <div class="p-3">
                <p class="small text-muted mb-2">These orders could not be pushed to Tally. Open one and hit Edit to fix and requeue it.</p>
                <a href="/SaleOrder?status=Error" class="btn btn-sm btn-outline-danger w-100">View &amp; Fix</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function triggerSync() {
    var btn = $('#syncBtn'), icon = $('#syncIcon');
    btn.prop('disabled', true); icon.addClass('spin');

    $.ajax({
        url: '/api/sync/trigger-masters', type: 'POST',
        headers: { 'RequestVerificationToken': $('[name=__RequestVerificationToken]').val() },
        success: function(r) {
            var status = (r.status || '').toLowerCase();
            var isWarning = status === 'warning' || status === 'busy';
            var toastType = r.success ? 'success' : (isWarning ? 'warning' : 'danger');
            var toastTitle = r.success ? 'Sync complete' : (status === 'busy' ? 'Sync in progress' : (status === 'warning' ? 'Open company needed' : 'Sync issue'));
            showToast(toastType, r.message, toastTitle);
        },
        error: function() {
            showToast('danger', 'Could not connect to Tally', 'Sync failed');
        },
        complete: function() { btn.prop('disabled', false); icon.removeClass('spin'); }
    });
}

function fmtMoney(n) {
    return '₹' + Math.round(n).toLocaleString('en-IN');
}

function renderRecentOrders(orders) {
    var badgeClass = { Pending: 'badge-pending', Synced: 'badge-synced', Invoiced: 'badge-invoiced', Error: 'badge-error' };
    if (!orders.length) {
        return '<div class="text-center text-muted py-4">' +
            '<i class="bi bi-inbox" style="font-size:32px;opacity:.4"></i>' +
            '<p class="mt-2 small">No orders yet. <a href="/SaleOrder/Create">Create first order</a></p></div>';
    }
    return orders.map(function(o) {
        var sc = badgeClass[o.status] || 'badge-cancelled';
        return '<a href="/SaleOrder/Details/' + o.saleOrderId + '" class="text-decoration-none">' +
            '<div class="order-card card px-3 py-2">' +
            '<div class="d-flex justify-content-between align-items-center">' +
            '<div style="min-width:0">' +
            '<div class="fw-semibold text-truncate" style="font-size:13px">' + escHtml(o.ledgerName) + '</div>' +
            '<div class="text-muted" style="font-size:11px">' + escHtml(o.orderNo) + ' · ' + escHtml(o.orderDate) + '</div>' +
            '</div>' +
            '<div class="text-end ms-2 flex-shrink-0">' +
            '<div class="fw-bold" style="font-size:13px">' + fmtMoney(o.totalAmount) + '</div>' +
            '<span class="badge ' + sc + '" style="font-size:.65rem">' + escHtml(o.status) + '</span>' +
            '</div></div></div></a>';
    }).join('');
}

function escHtml(str) {
    return $('<div>').text(str || '').html();
}

// Periodically refresh stat cards, recent orders and pending/error counts —
// background jobs (OrderPushJob etc.) change these outside of any click here,
// so a static server-rendered page would silently go stale.
function refreshDashboard() {
    $.get('/Dashboard/Refresh', function(r) {
        var s = r.stats;
        $('#statToday').text(s.todayCount);
        $('#statPending').text(s.pending);
        $('#statSynced').text(s.synced);
        $('#statInvoiced').text(s.invoiced);
        $('#statError').text(s.error);
        $('#statMonthValue').text(fmtMoney(s.monthValue));
        $('#statTotal').text(s.total);
        $('#statTotalValue').text(fmtMoney(s.totalValue));

        $('#recentOrdersList').html(renderRecentOrders(r.recentOrders));

        if (s.error > 0) {
            $('#errorAlertText').text(s.error + ' order(s) failed to sync');
            $('#errorAlertCard').show();
        } else {
            $('#errorAlertCard').hide();
        }
    });
}

setInterval(refreshDashboard, 30000);
</script>
@Html.AntiForgeryToken()
}
