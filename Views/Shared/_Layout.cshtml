@inject SaleOrd.Services.PermissionService _permSvc
@inject SaleOrd.Data.AppDbContext _db
@using Microsoft.EntityFrameworkCore
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - SaleOrder</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    // Read once, up here, so both the loader below and the topbar further
    // down (inside the authenticated block) can use the same value instead
    // of querying it twice per page.
    var _logoUrl = await _db.AppSettings.Where(s => s.Key == "LogoUrl").Select(s => s.Value).FirstOrDefaultAsync();
}
<body>
    <!-- Site Loader Overlay — see the hide script near </body> for why this
         no longer waits on window.load (external resources, even now-local
         ones, are not what gates this) and hides fast instead. -->
    <div id="siteLoader" class="site-loader-overlay">
        <div class="site-loader-spinner">
            <div class="spinner-ring"></div>
            <div class="spinner-logo">
                @if (!string.IsNullOrEmpty(_logoUrl))
                {
                    <img src="@_logoUrl" alt="Logo" />
                }
                else
                {
                    <i class="bi bi-bag-check-fill"></i>
                }
            </div>
            <div class="spinner-text">SaleOrder</div>
        </div>
    </div>

@if (User.Identity?.IsAuthenticated == true)
{
    var activePage = ViewData["ActivePage"]?.ToString() ?? "";

    string _userRole;
    if (User.IsInRole(SaleOrd.Models.Domain.AppRoles.Admin)) _userRole = SaleOrd.Models.Domain.AppRoles.Admin;
    else if (User.IsInRole(SaleOrd.Models.Domain.AppRoles.Manager)) _userRole = SaleOrd.Models.Domain.AppRoles.Manager;
    else _userRole = SaleOrd.Models.Domain.AppRoles.Salesman;
    var _perms = await _permSvc.GetAllowedKeysAsync(_userRole);

    <!-- ── Top bar ── -->
    <header class="topbar">
        <button class="topbar-toggle" id="sidebarToggle" onclick="toggleSidebar()">
            <i class="bi bi-list"></i>
        </button>
        <a href="/Dashboard" class="topbar-brand">
            @if (!string.IsNullOrEmpty(_logoUrl))
            {
                <img src="@_logoUrl" alt="Logo" class="brand-logo-img me-1" />
            }
            else
            {
                <i class="bi bi-bag-check-fill me-1"></i>
            }
            <span class="brand-text">SaleOrder</span>
        </a>

        <!-- Company switcher (ViewComponent) -->
        <div class="me-2 flex-shrink-0">
            @await Component.InvokeAsync("CompanySwitcher")
        </div>

        <div class="d-flex align-items-center gap-2 flex-shrink-0">
            <div class="d-none d-md-flex align-items-center gap-1 text-white-50 small">
                <i class="bi bi-person-circle"></i>
                <span>@User.Identity!.Name</span>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-light py-1 px-2" style="border-radius:8px;" title="Logout">
                    <i class="bi bi-box-arrow-right"></i>
                </button>
            </form>
        </div>
    </header>
    <script>
        // Everything below (.app-body's top padding, .sidebar's top offset)
        // reads --nav-h to know how much room the fixed topbar actually
        // takes up. Rather than trust the 56px CSS default is still correct
        // once real content (a logo, a long company name) is in there, this
        // measures the topbar's true rendered height right now and writes
        // it back — so downstream layout is always right, not assumed.
        // Runs inline/synchronously here (not deferred to the bottom of the
        // page) specifically so it applies before the browser paints,
        // avoiding any visible flash of misaligned content.
        (function () {
            var topbar = document.querySelector('.topbar');
            if (!topbar) return;
            function syncNavHeight() {
                document.documentElement.style.setProperty('--nav-h', topbar.offsetHeight + 'px');
            }
            syncNavHeight();
            window.addEventListener('resize', syncNavHeight);
            window.addEventListener('load', syncNavHeight); // catches the logo image finishing load
            var logo = topbar.querySelector('.brand-logo-img');
            if (logo) {
                logo.addEventListener('load', syncNavHeight);
                logo.addEventListener('error', syncNavHeight);
            }
        })();
    </script>

    <!-- ── Sidebar overlay (mobile tap-to-close) ── -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <!-- ── Sidebar ── -->
    <nav class="sidebar" id="sidebar">
        <div class="sidebar-section">
            @if (_perms.Contains(SaleOrd.Models.Domain.AppPermissions.Dashboard))
            {
                <a href="/Dashboard" class="sidebar-link @(activePage == "Dashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i>Dashboard
                </a>
            }
            @if (_perms.Contains(SaleOrd.Models.Domain.AppPermissions.SaleOrderCreate))
            {
                <a href="/SaleOrder/Create" class="sidebar-link @(activePage == "NewOrder" ? "active" : "")" style="color:var(--primary)">
                    <i class="bi bi-plus-circle-fill"></i>New Sale Order
                </a>
            }
            @if (_perms.Contains(SaleOrd.Models.Domain.AppPermissions.SaleOrderView))
            {
                <a href="/SaleOrder" class="sidebar-link @(activePage == "Orders" ? "active" : "")">
                    <i class="bi bi-file-earmark-text"></i>Sale Orders
                </a>
            }
        </div>

        @{
            bool _showMasters = _perms.Contains(SaleOrd.Models.Domain.AppPermissions.MastersParties)
                || _perms.Contains(SaleOrd.Models.Domain.AppPermissions.MastersItems);
        }
        @if (_showMasters)
        {
            <div class="sidebar-section">
                <div class="sidebar-label">Masters</div>
                @if (_perms.Contains(SaleOrd.Models.Domain.AppPermissions.MastersParties))
                {
                    <a href="/Masters/Parties" class="sidebar-link @(activePage == "Parties" ? "active" : "")">
                        <i class="bi bi-people"></i>Parties
                    </a>
                }
                @if (_perms.Contains(SaleOrd.Models.Domain.AppPermissions.MastersItems))
                {
                    <a href="/Masters/Items" class="sidebar-link @(activePage == "Items" ? "active" : "")">
                        <i class="bi bi-box-seam"></i>Stock Items
                    </a>
                }
            </div>
        }

        @{
            bool _showReports = _perms.Any(p => p.StartsWith("Reports."));
            bool _reportsOpen = activePage != null && activePage.StartsWith("Reports");
        }
        @if (_showReports)
        {
            <div class="sidebar-section">
                <a class="sidebar-link d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse" href="#reportsCollapse" role="button"
                   aria-expanded="@(_reportsOpen ? "true" : "false")" aria-controls="reportsCollapse">
                    <span><i class="bi bi-bar-chart-line"></i>Reports</span>
                    <i class="bi bi-chevron-down sidebar-chevron"></i>
                </a>
                <div class="collapse @(_reportsOpen ? "show" : "")" id="reportsCollapse">
                    @if (_perms.Contains(SaleOrd.Models.Domain.AppPermissions.ReportsSummary))
                    {
                        <a href="/Reports/Summary" class="sidebar-link sidebar-sub @(activePage == "ReportsSummary" ? "active" : "")">
                            <i class="bi bi-graph-up"></i>Sales Summary
                        </a>
                    }
                    @if (_perms.Contains(SaleOrd.Models.Domain.AppPermissions.ReportsPartyWise) && _userRole != SaleOrd.Models.Domain.AppRoles.Salesman)
                    {
                        <a href="/Reports/PartyWise" class="sidebar-link sidebar-sub @(activePage == "ReportsPartyWise" ? "active" : "")">
                            <i class="bi bi-people"></i>Party-wise
                        </a>
                    }
                    @if (_perms.Contains(SaleOrd.Models.Domain.AppPermissions.ReportsDayWise))
                    {
                        <a href="/Reports/DayWise" class="sidebar-link sidebar-sub @(activePage == "ReportsDayWise" ? "active" : "")">
                            <i class="bi bi-calendar3"></i>Day-wise
                        </a>
                    }
                    @if (_perms.Contains(SaleOrd.Models.Domain.AppPermissions.ReportsUserWise) && _userRole != SaleOrd.Models.Domain.AppRoles.Salesman)
                    {
                        <a href="/Reports/UserWise" class="sidebar-link sidebar-sub @(activePage == "ReportsUserWise" ? "active" : "")">
                            <i class="bi bi-person-lines-fill"></i>User-wise
                        </a>
                    }
                    @if (_perms.Contains(SaleOrd.Models.Domain.AppPermissions.ReportsPending))
                    {
                        <a href="/Reports/Pending" class="sidebar-link sidebar-sub @(activePage == "ReportsPending" ? "active" : "")">
                            <i class="bi bi-hourglass-split"></i>Pending Orders
                        </a>
                    }
                    @if (_perms.Contains(SaleOrd.Models.Domain.AppPermissions.ReportsUserPerf) && _userRole != SaleOrd.Models.Domain.AppRoles.Salesman)
                    {
                        <a href="/Reports/UserPerf" class="sidebar-link sidebar-sub @(activePage == "ReportsUserPerf" ? "active" : "")">
                            <i class="bi bi-award"></i>User Performance
                        </a>
                    }
                </div>
            </div>
        }

        @if (User.IsInRole("Admin"))
        {
            var _pendingSignups = await _db.SignupRequests.CountAsync(r => r.Status == SaleOrd.Models.Domain.SignupRequestStatus.Pending);
            var _pendingParties = await _db.Ledgers.CountAsync(l => l.ApprovalStatus == SaleOrd.Models.Domain.LedgerApprovalStatus.Pending);
            <div class="sidebar-section">
                <div class="sidebar-label">Admin</div>
                <a href="/Admin/Companies" class="sidebar-link @(activePage == "Companies" ? "active" : "")">
                    <i class="bi bi-building"></i>Companies
                </a>
                <a href="/Admin/Users" class="sidebar-link @(activePage == "Users" ? "active" : "")">
                    <i class="bi bi-people-fill"></i>Users
                </a>
                <a href="/Admin/SignupRequests" class="sidebar-link @(activePage == "SignupRequests" ? "active" : "")">
                    <i class="bi bi-person-plus"></i>Signup Requests
                    @if (_pendingSignups > 0)
                    {
                        <span class="badge bg-danger ms-1">@_pendingSignups</span>
                    }
                </a>
                <a href="/Admin/PendingParties" class="sidebar-link @(activePage == "PendingParties" ? "active" : "")">
                    <i class="bi bi-person-check"></i>Party Approvals
                    @if (_pendingParties > 0)
                    {
                        <span class="badge bg-danger ms-1">@_pendingParties</span>
                    }
                </a>
                <a href="/Admin/RoleRights" class="sidebar-link @(activePage == "RoleRights" ? "active" : "")">
                    <i class="bi bi-shield-lock"></i>Role Rights
                </a>
                <a href="/Admin/ManageRoles" class="sidebar-link @(activePage == "ManageRoles" ? "active" : "")">
                    <i class="bi bi-person-gear"></i>Manage Roles
                </a>
                <a href="/Admin/UserActivity" class="sidebar-link @(activePage == "UserActivity" ? "active" : "")">
                    <i class="bi bi-activity"></i>User Activity
                </a>
                <a href="/Admin/SyncLogs" class="sidebar-link @(activePage == "SyncLogs" ? "active" : "")">
                    <i class="bi bi-arrow-repeat"></i>Sync Logs
                </a>
                <a href="/Settings" class="sidebar-link @(activePage == "Settings" ? "active" : "")">
                    <i class="bi bi-sliders"></i>Settings
                </a>
            </div>
        }
    </nav>

    <!-- ── Main content ── -->
    <div class="app-body">
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <!-- ── Bottom nav (mobile only) ── -->
    <nav class="bottom-nav d-flex d-lg-none">
        <a href="/Dashboard" class="bottom-nav-item @(activePage == "Dashboard" ? "active" : "")">
            <i class="bi bi-speedometer2"></i><span>Home</span>
        </a>
        <a href="/SaleOrder" class="bottom-nav-item @(activePage == "Orders" ? "active" : "")">
            <i class="bi bi-file-earmark-text"></i><span>Orders</span>
        </a>
        <a href="/SaleOrder/Create" class="bottom-nav-item create-btn">
            <i class="bi bi-plus-lg"></i>
        </a>
        <a href="/Reports" class="bottom-nav-item @(activePage == "Reports" ? "active" : "")">
            <i class="bi bi-bar-chart"></i><span>Reports</span>
        </a>
        @if (_showMasters)
        {
            <a href="/Masters/Parties" class="bottom-nav-item @(activePage == "Parties" ? "active" : "")">
                <i class="bi bi-people"></i><span>Masters</span>
            </a>
        }
    </nav>
}
else
{
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/toastr/toastr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
toastr.options = { "positionClass": "toast-top-right", "timeOut": 3000, "progressBar": true };
function showToast(type, msg, title) {
    toastr[type === 'danger' ? 'error' : type](msg, title || '');
}
</script>
@if (TempData["Success"] != null)
{
    <script>showToast('success', "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Success"]!.ToString()!))");</script>
}
@if (TempData["Error"] != null)
{
    <script>showToast('danger', "@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Error"]!.ToString()!))");</script>
}
<script>
function toggleSidebar() {
    var s = document.getElementById('sidebar'), o = document.getElementById('sidebarOverlay');
    var opening = !s.classList.contains('open');
    s.classList.toggle('open'); o.classList.toggle('show');
    document.body.classList.toggle('sidebar-locked', opening);
}
function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sidebarOverlay').classList.remove('show');
    document.body.classList.remove('sidebar-locked');
}
</script>
@await RenderSectionAsync("Scripts", required: false)
<script>
    // This used to wait for window.load, which only fires once every
    // resource on the page — including the two external CDN links this
    // layout used to pull in for icons/toasts — has finished. If a CDN was
    // ever slow or briefly unreachable, load could take a long time (or
    // effectively hang), which is exactly why the loader would sometimes
    // keep spinning well after the page was already fully visible and
    // usable underneath it. Those assets are vendored locally now (see the
    // <link>/<script> tags above), removing that dependency — but on top of
    // that, this script tag sits right before </body>, so by the time it
    // runs, everything the page needs to look complete has already been
    // parsed; there's nothing left to wait for. A short minimum-display
    // delay just avoids an instant, jarring flash on pages that render
    // very fast.
    (function () {
        var loader = document.getElementById('siteLoader');
        if (!loader) return;
        setTimeout(function () {
            loader.classList.add('fade-out');
            setTimeout(function () { loader.style.display = 'none'; }, 300);
        }, 150);
    })();
    // Absolute safety net in case the above never ran for some reason —
    // far shorter than it used to be (1.5s vs 3s), since we no longer
    // expect to actually need it.
    setTimeout(function() {
        var loader = document.getElementById('siteLoader');
        if (loader && !loader.classList.contains('fade-out')) {
            loader.classList.add('fade-out');
            setTimeout(function() { loader.style.display = 'none'; }, 300);
        }
    }, 1500);
</script>
</body>
</html>
