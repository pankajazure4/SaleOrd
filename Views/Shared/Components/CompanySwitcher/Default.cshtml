@model SaleOrd.ViewComponents.CompanySwitcherVM

@if (Model.Companies.Count == 1)
{
    <span class="company-chip d-none d-md-inline-flex align-items-center gap-1">
        <i class="bi bi-building"></i>@Model.Active?.CompanyName
    </span>
}
else
{
    <div class="dropdown">
        <button class="btn btn-sm company-switcher-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-building me-1"></i>
            <span class="d-none d-md-inline">@Model.Active?.CompanyName</span>
            <span class="d-md-none">@(ShortName(Model.Active?.CompanyName))</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow">
            <li><h6 class="dropdown-header" style="font-size:11px">Switch Company</h6></li>
            @foreach (var c in Model.Companies)
            {
                <li>
                    <form method="post" asp-controller="Account" asp-action="SwitchCompany" style="display:contents">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="companyId" value="@c.CompanyId" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="dropdown-item d-flex align-items-center gap-2 @(c.CompanyId == Model.Active?.CompanyId ? "active" : "")">
                            <div style="width:28px;height:28px;border-radius:8px;background:var(--primary-soft);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;color:var(--primary);flex-shrink:0">
                                @(string.IsNullOrWhiteSpace(c.CompanyName) ? "?" : c.CompanyName[0])
                            </div>
                            <div>
                                <div style="font-size:13px">@c.CompanyName</div>
                                <div class="text-muted" style="font-size:10px">@c.TallyCompanyName</div>
                            </div>
                            @if (c.CompanyId == Model.Active?.CompanyId)
                            {
                                <i class="bi bi-check2 text-primary ms-auto"></i>
                            }
                        </button>
                    </form>
                </li>
            }
        </ul>
    </div>
}

@functions {
    private static string ShortName(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Company";
        return value.Length > 12 ? value[..12] + "..." : value;
    }
}
