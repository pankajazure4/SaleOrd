@using SaleOrd.Licensing
@{
    ViewData["Title"] = "Settings";
    ViewData["ActivePage"] = "Settings";
    var companies = ViewBag.Companies as IEnumerable<SaleOrd.Models.Domain.Company> ?? Enumerable.Empty<SaleOrd.Models.Domain.Company>();
    var selectedCompanyId = (int)(ViewBag.SelectedCompanyId ?? 0);
    var licenseStatus = ViewBag.LicenseStatus as LicenseValidationResult;
}
@Html.AntiForgeryToken()

<div class="page-header mb-4">
    <div>
        <h5 class="mb-0">Settings</h5>
        <div class="page-title-sub">Global configuration</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">

        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-key-fill me-2 text-primary"></i>License
            </div>
            <div class="p-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span id="licenseStatusBadge" class="badge bg-@(licenseStatus?.IsValid == true ? "success" : "danger")">
                        @(licenseStatus?.IsValid == true ? (licenseStatus.IsTrial ? "Trial" : "Active") : "Not Licensed")
                    </span>
                    @if (licenseStatus?.ExpiresOn != null)
                    {
                        <span class="small text-muted">Expires @licenseStatus.ExpiresOn.Value.ToString("dd-MMM-yyyy")</span>
                    }
                </div>
                <div id="licenseStatusMessage" class="small text-muted mb-3">@licenseStatus?.Message</div>

                <label class="form-label">License Key</label>
                <div class="input-group mb-2">
                    <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                    <input type="text" id="licenseKey" class="form-control"
                           placeholder="@(string.IsNullOrEmpty((string)ViewBag.LicenseMaskedKey) ? "Paste license key..." : ViewBag.LicenseMaskedKey)" />
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button id="btnActivateLicense" class="btn btn-primary btn-sm" type="button" onclick="saveLicense()"
                            style="@(ViewBag.LicenseHasKey == true ? "display:none" : "")">
                        <i class="bi bi-floppy me-1"></i>Activate / Save
                    </button>
                    <button id="btnCheckLicense" class="btn btn-outline-primary btn-sm" type="button" onclick="checkLicense()"
                            @(ViewBag.LicenseHasKey == true ? "" : "disabled")>
                        <i class="bi bi-arrow-clockwise me-1"></i>Check Now
                    </button>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-image me-2 text-primary"></i>Application Logo
            </div>
            <div class="p-3">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="d-flex align-items-center justify-content-center border rounded"
                         style="width:72px;height:72px;overflow:hidden;background:#fff">
                        @if (!string.IsNullOrEmpty((string)ViewBag.LogoUrl))
                        {
                            <img src="@ViewBag.LogoUrl" alt="Logo" style="max-width:100%;max-height:100%;object-fit:contain" />
                        }
                        else
                        {
                            <i class="bi bi-bag-check-fill text-muted" style="font-size:28px"></i>
                        }
                    </div>
                    <div class="text-muted small">Shown on the login screen and the app's top bar. PNG, JPG or SVG, max 2 MB.</div>
                </div>
                <form asp-action="UploadLogo" method="post" enctype="multipart/form-data" class="d-flex gap-2 flex-wrap align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="file" name="logo" accept=".png,.jpg,.jpeg,.svg" class="form-control form-control-sm" style="max-width:260px" required />
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-upload me-1"></i>Upload</button>
                </form>
                @if (!string.IsNullOrEmpty((string)ViewBag.LogoUrl))
                {
                    <form asp-action="RemoveLogo" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i>Remove Logo</button>
                    </form>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-plug me-2 text-primary"></i>Tally Connection
            </div>
            <div class="p-3">
                <label class="form-label">Tally URL</label>
                <div class="input-group mb-2">
                    <span class="input-group-text"><i class="bi bi-link-45deg"></i></span>
                    <input type="text" id="tallyUrl" class="form-control"
                           value="@ViewBag.TallyUrl"
                           placeholder="http://localhost:9000" />
                </div>
                <div class="text-muted mb-3" style="font-size:12px">
                    Format: <code>http://IP:Port</code> - e.g. <code>http://192.168.1.10:9000</code><br />
                    Default from appsettings.json: <code>@ViewBag.DefaultUrl</code>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary btn-sm" type="button" onclick="saveTallyUrl()">
                        <i class="bi bi-floppy me-1"></i>Save
                    </button>
                    <button class="btn btn-outline-primary btn-sm" type="button" onclick="checkStatus()">
                        <i class="bi bi-wifi me-1"></i>Check Status
                    </button>
                </div>
                <div id="openCompanyInfo" class="mt-2 small fw-semibold" style="display:none"></div>
            </div>
        </div>

        <div class="card">
                <div class="card-header">
                    <i class="bi bi-trash3 me-2 text-danger"></i>Delete Synced Data
                </div>
            <div class="p-3">
                <div class="mb-2">
                    <label class="form-label">Company</label>
                    <select id="flushCompanyId" class="form-select">
                        @foreach (var c in companies)
                        {
                            <option value="@c.CompanyId">
                                @c.CompanyName
                            </option>
                        }
                    </select>
                </div>
                <div class="text-muted small mb-3">
                    This will delete synced data, synced orders, and sync logs for the selected company.
                </div>
                <button class="btn btn-outline-danger btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#flushModal" @(companies.Any() ? "" : "disabled")>
                    <i class="bi bi-trash3 me-1"></i>Delete Data
                </button>
            </div>
        </div>

        <!-- Tax Settings -->
        <div class="card mt-3">
            <div class="card-header fw-semibold py-2">
                <i class="bi bi-percent me-2 text-primary"></i>Tax Settings
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success py-2 small mb-3">@TempData["Success"]</div>
                }
                <form method="post" asp-action="SaveTaxSettings">
                    @Html.AntiForgeryToken()
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Default Tax Type</label>
                            <select name="defaultTaxType" class="form-select form-select-sm">
                                @foreach (var opt in new[] { ("None","No Tax"), ("IGST","IGST"), ("CGST_SGST","CGST + SGST") })
                                {
                                    if ((string)ViewBag.DefaultTaxType == opt.Item1)
                                    {
                                        <option value="@opt.Item1" selected>@opt.Item2</option>
                                    }
                                    else
                                    {
                                        <option value="@opt.Item1">@opt.Item2</option>
                                    }
                                }
                            </select>
                            <div class="text-muted" style="font-size:11px">Whether orders use IGST or CGST+SGST — the % itself always comes from each item's own Tally GST master data, not a flat rate here.</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Sales Ledger Name</label>
                            <input type="text" name="salesLedger" class="form-control form-control-sm"
                                   value="@ViewBag.SalesLedger" placeholder="Sales" />
                            <div class="text-muted" style="font-size:11px">Sales account in voucher (e.g. GST SALES)</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Round Off Ledger Name</label>
                            <input type="text" name="taxLedgerRoundOff" class="form-control form-control-sm"
                                   value="@ViewBag.TaxLedgerRoundOff" placeholder="Round Off" />
                            <div class="text-muted" style="font-size:11px">Rounding adjustment ledger (e.g. Rounding Off)</div>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold">IGST Ledger Name</label>
                            <input type="text" name="taxLedgerIGST" class="form-control form-control-sm"
                                   value="@ViewBag.TaxLedgerIGST" placeholder="IGST" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold">CGST Ledger Name</label>
                            <input type="text" name="taxLedgerCGST" class="form-control form-control-sm"
                                   value="@ViewBag.TaxLedgerCGST" placeholder="CGST" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold">SGST Ledger Name</label>
                            <input type="text" name="taxLedgerSGST" class="form-control form-control-sm"
                                   value="@ViewBag.TaxLedgerSGST" placeholder="SGST" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm mt-3">
                        <i class="bi bi-save me-1"></i>Save Tax Settings
                    </button>
                </form>
            </div>
        </div>

        <!-- Order Defaults -->
        <div class="card mt-3">
            <div class="card-header fw-semibold py-2">
                <i class="bi bi-box-seam me-2 text-primary"></i>Order Defaults
            </div>
            <div class="card-body">
                <form method="post" asp-action="SaveOrderDefaults">
                    @Html.AntiForgeryToken()
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Default Voucher Type</label>
                            <input type="text" name="defaultVoucherType" class="form-control form-control-sm"
                                   value="@ViewBag.DefaultVoucherType" placeholder="Sales Order" />
                            <div class="text-muted" style="font-size:11px">Voucher type used when pushing orders to Tally</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Default Godown</label>
                            <select name="defaultGodownName" class="form-select form-select-sm">
                                <option value="">None</option>
                                @foreach (var g in (IEnumerable<SaleOrd.Models.Domain.Godown>)ViewBag.Godowns)
                                {
                                    if ((string)ViewBag.DefaultGodownName == g.GodownName)
                                    {
                                        <option value="@g.GodownName" selected>@g.GodownName</option>
                                    }
                                    else
                                    {
                                        <option value="@g.GodownName">@g.GodownName</option>
                                    }
                                }
                            </select>
                            <div class="text-muted" style="font-size:11px">Applied automatically to every item — no per-item Godown picker in the order form</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Default Batch</label>
                            <input type="text" name="defaultBatchName" class="form-control form-control-sm"
                                   value="@ViewBag.DefaultBatchName" placeholder="Primary Batch" />
                            <div class="text-muted" style="font-size:11px">Batch name used in the Tally push wherever batch allocation applies</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Tally FSSAI UDF Field</label>
                            <input type="text" name="tallyFssaiUdfField" class="form-control form-control-sm"
                                   value="@ViewBag.TallyFssaiUdfField" placeholder="e.g. _UDF_788534681 (leave blank to skip)" />
                            <div class="text-muted" style="font-size:11px">
                                Only if your Tally has a custom User Defined Field for Food License No. — check a ledger export
                                in Tally for a tag like <code>UDF:_UDF_788534681</code> and paste the <code>_UDF_...</code> part here.
                                Left blank, FSSAI No. is saved here but not sent to Tally (no error either way).
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm mt-3">
                        <i class="bi bi-save me-1"></i>Save Order Defaults
                    </button>
                </form>
            </div>
        </div>

    </div>
    <div class="col-lg-5 d-none d-lg-block">
        <div class="card p-3 border-0 bg-blue-soft">
            <div class="fw-semibold mb-2 small"><i class="bi bi-info-circle text-primary me-1"></i>How it works</div>
            <ul class="small text-muted mb-0 ps-3">
                <li class="mb-1">One Tally URL connects all companies.</li>
                <li class="mb-1">Tally Prime must have HTTP Server enabled (F12 - Configure - Advanced).</li>
                <li class="mb-1">Check Status shows which companies are currently open in Tally.</li>
                <li>Leave blank to use the default from appsettings.json.</li>
            </ul>
        </div>
    </div>
</div>

<div class="modal fade" id="flushModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete synced data?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">This will permanently remove synced data, synced orders, and logs for the selected company.</p>
                <p class="small text-muted mb-0">Make sure you picked the correct company before continuing.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-action="FlushCompanyData" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="companyId" id="flushCompanyIdInput" value="@selectedCompanyId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash3 me-1"></i>Yes, Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
var csrf = $('[name=__RequestVerificationToken]').val();

$('#flushCompanyId').val('@selectedCompanyId');
$('#flushCompanyIdInput').val('@selectedCompanyId');

$('#flushCompanyId').on('change', function () {
    $('#flushCompanyIdInput').val($(this).val());
});

function saveLicense() {
    var key = $('#licenseKey').val().trim();
    if (!key) {
        showToast('danger', 'Enter a license key.', 'Error');
        return;
    }
    $.post('/Settings/SaveLicense', { licenseKey: key, __RequestVerificationToken: csrf }, function(r) {
        showToast(r.success ? 'success' : 'danger', r.message, r.success ? 'Activated' : 'Error');
        // A key is now saved regardless of whether the portal accepted it —
        // Check Now becomes the way to re-validate; Save only reappears if
        // the admin types a different key (see #licenseKey input handler).
        $('#btnActivateLicense').hide();
        $('#btnCheckLicense').prop('disabled', false);
        if (r.success) {
            $('#licenseStatusBadge').removeClass('bg-danger').addClass('bg-success').text(r.isTrial ? 'Trial' : 'Active');
        } else {
            $('#licenseStatusBadge').removeClass('bg-success').addClass('bg-danger').text('Not Licensed');
        }
        $('#licenseKey').val('').attr('placeholder', r.maskedKey);
        $('#licenseStatusMessage').text(r.message);
    }).fail(function() {
        showToast('danger', 'Request failed', 'Error');
    });
}

function checkLicense() {
    $.post('/Settings/CheckLicense', { __RequestVerificationToken: csrf }, function(r) {
        showToast(r.success ? 'success' : 'danger', r.message, r.success ? 'Valid' : 'Invalid');
        $('#licenseStatusBadge').toggleClass('bg-success', r.success).toggleClass('bg-danger', !r.success)
            .text(r.success ? (r.isTrial ? 'Trial' : 'Active') : 'Not Licensed');
        $('#licenseStatusMessage').text(r.message);
    }).fail(function() {
        showToast('danger', 'Request failed', 'Error');
    });
}

// Typing a new key signals intent to change it — bring the Save button back.
$('#licenseKey').on('input', function () {
    if ($(this).val().trim().length > 0) $('#btnActivateLicense').show();
});

function saveTallyUrl() {
    var url = $('#tallyUrl').val().trim();
    $.post('/Settings/SaveTallyUrl', { tallyUrl: url, __RequestVerificationToken: csrf }, function(r) {
        showToast(r.success ? 'success' : 'danger', r.message, r.success ? 'Saved' : 'Error');
    });
}

function checkStatus(silent) {
    var url = $('#tallyUrl').val().trim() || '@ViewBag.DefaultUrl';
    $.post('/Settings/CheckStatus', { tallyUrl: url, __RequestVerificationToken: csrf }, function(r) {
        if (!silent) {
            var type = r.status === 'warning' ? 'warning' : (r.reachable ? 'success' : 'danger');
            var title = r.status === 'warning' ? 'Open company needed' : (r.reachable ? 'Online' : 'Offline');
            showToast(type, r.message, title);
        }

        // Auto-select the matched company in the flush dropdown
        if (r.matchedCompanyId && r.matchedCompanyId > 0) {
            $('#flushCompanyId').val(r.matchedCompanyId);
            $('#flushCompanyIdInput').val(r.matchedCompanyId);
        }

        // Show open company indicator
        var info = $('#openCompanyInfo');
        if (r.companies && r.companies.length > 0) {
            info.removeClass('text-muted text-danger').addClass('text-success');
            info.html('<i class="bi bi-building-check me-1"></i>Open in Tally: ' + r.companies.join(', ')).show();
        } else if (r.reachable) {
            info.removeClass('text-success text-danger').addClass('text-muted');
            info.html('<i class="bi bi-building-x me-1"></i>No company open in Tally').show();
        } else {
            info.hide();
        }
    }).fail(function() {
        if (!silent) showToast('danger', 'Request failed', 'Offline');
    });
}

// This used to run server-side and block the whole page on a live Tally
// call before anything rendered. Now the page shows up immediately with a
// safe default, and this quietly re-checks in the background right after —
// same end result (matched company gets pre-selected, status badge
// appears), just never gates getting to Settings on Tally being reachable.
$(function() { checkStatus(true); });
</script>
}
