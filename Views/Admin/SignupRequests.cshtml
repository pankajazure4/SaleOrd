@model IEnumerable<SaleOrd.Models.ViewModels.SignupRequestListVM>
@{
    ViewData["Title"] = "Signup Requests";
    ViewData["ActivePage"] = "SignupRequests";
    var pendingCount = Model.Count(r => r.Status == SaleOrd.Models.Domain.SignupRequestStatus.Pending);
}

<div class="page-header">
    <div>
        <h5>Signup Requests</h5>
        <div class="page-title-sub">@pendingCount pending of @Model.Count() total</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 small">@TempData["Error"]</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th class="d-none d-md-table-cell">Email / Phone</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th class="d-none d-md-table-cell">Requested</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    string statusBadge = r.Status switch
                    {
                        SaleOrd.Models.Domain.SignupRequestStatus.Approved => "success",
                        SaleOrd.Models.Domain.SignupRequestStatus.Rejected => "secondary",
                        _ => "warning text-dark"
                    };
                    <tr>
                        <td>
                            <div class="fw-semibold" style="font-size:13px">@r.FullName</div>
                            <div class="d-md-none text-muted" style="font-size:11px">@r.Email</div>
                        </td>
                        <td class="d-none d-md-table-cell text-muted small">
                            @r.Email
                            @if (!string.IsNullOrWhiteSpace(r.PhoneNumber))
                            {
                                <div>@r.PhoneNumber</div>
                            }
                        </td>
                        <td><span class="company-chip">@r.RequestedCompanyName</span></td>
                        <td>
                            <span class="badge bg-@statusBadge">@r.Status</span>
                            @if (r.Status == SaleOrd.Models.Domain.SignupRequestStatus.Rejected && !string.IsNullOrWhiteSpace(r.RejectionReason))
                            {
                                <div class="text-muted" style="font-size:11px">@r.RejectionReason</div>
                            }
                            @if (r.Status != SaleOrd.Models.Domain.SignupRequestStatus.Pending && r.ReviewedByName != null)
                            {
                                <div class="text-muted" style="font-size:11px">by @r.ReviewedByName</div>
                            }
                        </td>
                        <td class="d-none d-md-table-cell text-muted small">@r.RequestedAt.ToString("dd-MMM-yyyy hh:mm tt")</td>
                        <td class="text-end">
                            @if (r.Status == SaleOrd.Models.Domain.SignupRequestStatus.Pending)
                            {
                                <div class="d-flex justify-content-end gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#approveModal@(r.SignupRequestId)">
                                        <i class="bi bi-check-lg"></i> Approve
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal@(r.SignupRequestId)">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>
                                </div>

                                <!-- Approve modal -->
                                <div class="modal fade" id="approveModal@(r.SignupRequestId)" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form method="post" asp-action="ApproveSignup">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@r.SignupRequestId" />
                                                <div class="modal-header">
                                                    <h6 class="modal-title">Approve @r.FullName</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <label class="form-label small fw-semibold">Role</label>
                                                    <select name="role" class="form-select">
                                                        <option value="Salesman" selected>Salesman — Create &amp; view own</option>
                                                        <option value="Manager">Manager — View all orders</option>
                                                        <option value="Admin">Admin — Full access</option>
                                                    </select>
                                                    <div class="text-muted small mt-2">
                                                        Company access: <strong>@r.RequestedCompanyName</strong> (the requested one — add more later from Edit User if needed).
                                                    </div>
                                                    <div class="text-muted small mt-2">
                                                        A default password will be set for this login. You'll see it after approving — share it with the user.
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Reject modal -->
                                <div class="modal fade" id="rejectModal@(r.SignupRequestId)" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form method="post" asp-action="RejectSignup">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@r.SignupRequestId" />
                                                <div class="modal-header">
                                                    <h6 class="modal-title">Reject @r.FullName</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <label class="form-label small fw-semibold">Reason (optional)</label>
                                                    <textarea name="reason" class="form-control" rows="2" placeholder="Optional note"></textarea>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
