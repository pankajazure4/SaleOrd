@model IEnumerable<SaleOrd.Models.ViewModels.PartyApprovalListVM>
@{
    ViewData["Title"] = "Pending Parties";
    ViewData["ActivePage"] = "PendingParties";
    var pendingCount = Model.Count(p => p.ApprovalStatus == SaleOrd.Models.Domain.LedgerApprovalStatus.Pending);
}

<div class="page-header">
    <div>
        <h5>Party Approvals</h5>
        <div class="page-title-sub">@pendingCount pending of @Model.Count() total — parties created from Masters &gt; Parties aren't usable in Sale Orders until approved here</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 small">@TempData["Error"]</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Party</th>
                    <th class="d-none d-md-table-cell">GST / FSSAI</th>
                    <th class="d-none d-md-table-cell">Contact</th>
                    <th>Status</th>
                    <th class="d-none d-md-table-cell">Submitted</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    string statusBadge = p.ApprovalStatus switch
                    {
                        SaleOrd.Models.Domain.LedgerApprovalStatus.Approved => "success",
                        SaleOrd.Models.Domain.LedgerApprovalStatus.Rejected => "secondary",
                        _ => "warning text-dark"
                    };
                    <tr>
                        <td>
                            <div class="fw-semibold" style="font-size:13px">@p.LedgerName</div>
                            <div class="d-md-none text-muted" style="font-size:11px">@p.Address</div>
                        </td>
                        <td class="d-none d-md-table-cell text-muted small">
                            @if (!string.IsNullOrWhiteSpace(p.GSTNo)) { <div>GST: @p.GSTNo</div> }
                            @if (!string.IsNullOrWhiteSpace(p.FSSAINo))
                            {
                                <div>
                                    FSSAI: @p.FSSAINo
                                    @if (p.HasFssaiDocument)
                                    {
                                        <a href="@Url.Action("FssaiDocument", "Masters", new { ledgerId = p.LedgerId })" target="_blank" class="ms-1" title="View FSSAI document">
                                            <i class="bi bi-file-earmark-pdf-fill text-danger"></i>
                                        </a>
                                    }
                                </div>
                            }
                        </td>
                        <td class="d-none d-md-table-cell text-muted small">@p.MobileNo</td>
                        <td>
                            <span class="badge bg-@statusBadge">@p.ApprovalStatus</span>
                            @if (p.ApprovalStatus == SaleOrd.Models.Domain.LedgerApprovalStatus.Rejected && !string.IsNullOrWhiteSpace(p.RejectionReason))
                            {
                                <div class="text-muted" style="font-size:11px">@p.RejectionReason</div>
                            }
                            @if (p.ApprovalStatus != SaleOrd.Models.Domain.LedgerApprovalStatus.Pending && p.ReviewedByName != null)
                            {
                                <div class="text-muted" style="font-size:11px">by @p.ReviewedByName</div>
                            }
                        </td>
                        <td class="d-none d-md-table-cell text-muted small">@p.LastSyncedAt.ToString("dd-MMM-yyyy hh:mm tt")</td>
                        <td class="text-end">
                            @if (p.ApprovalStatus == SaleOrd.Models.Domain.LedgerApprovalStatus.Pending)
                            {
                                <div class="d-flex justify-content-end gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#approveModal@(p.LedgerId)">
                                        <i class="bi bi-check-lg"></i> Approve
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal@(p.LedgerId)">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>
                                </div>

                                <!-- Approve modal -->
                                <div class="modal fade" id="approveModal@(p.LedgerId)" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form method="post" asp-action="ApproveParty">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@p.LedgerId" />
                                                <div class="modal-header">
                                                    <h6 class="modal-title">Approve @p.LedgerName</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="text-muted small">
                                                        This makes the party usable in Sale Orders and pushes it to Tally as a new ledger master.
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-success btn-sm">Approve</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Reject modal -->
                                <div class="modal fade" id="rejectModal@(p.LedgerId)" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form method="post" asp-action="RejectParty">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@p.LedgerId" />
                                                <div class="modal-header">
                                                    <h6 class="modal-title">Reject @p.LedgerName</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <label class="form-label small fw-semibold">Reason (optional)</label>
                                                    <textarea name="reason" class="form-control" rows="2" placeholder="Optional note"></textarea>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
