@model IEnumerable<SaleOrd.Models.ViewModels.PartyApprovalListVM>
@{
    ViewData["Title"] = "Pending Parties";
    ViewData["ActivePage"] = "PendingParties";
    var pendingCount = Model.Count(p => p.ApprovalStatus == SaleOrd.Models.Domain.LedgerApprovalStatus.Pending);
}

<div class="page-header">
    <div>
        <h5>Party Approvals</h5>
        <div class="page-title-sub">@pendingCount pending of @Model.Count() manually-created — parties created from Masters &gt; Parties aren't usable in Sale Orders until approved here</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger py-2 small">@TempData["Error"]</div>
}

<form method="get" class="card p-2 mb-3">
    <div class="input-group input-group-sm">
        <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
        <input type="text" name="q" class="form-control" placeholder="Search by party, outlet, GST or contact…" value="@ViewBag.SearchTerm" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.SearchTerm))
        {
            <a href="@Url.Action("PendingParties")" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Party</th>
                    <th>GST / FSSAI</th>
                    <th>Contact</th>
                    <th>Status</th>
                    <th class="d-none d-md-table-cell">Submitted</th>
                    <th class="d-none d-md-table-cell">Tally Synced</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    string statusBadge = p.ApprovalStatus switch
                    {
                        SaleOrd.Models.Domain.LedgerApprovalStatus.Approved => "success",
                        SaleOrd.Models.Domain.LedgerApprovalStatus.Rejected => "secondary",
                        _ => "warning text-dark"
                    };
                    <tr>
                        <td>
                            <div class="fw-semibold" style="font-size:13px">@p.LedgerName</div>
                            @if (!string.IsNullOrWhiteSpace(p.OutletName))
                            {
                                <div class="text-muted" style="font-size:11px">Outlet: @p.OutletName</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.Address) || !string.IsNullOrWhiteSpace(p.State))
                            {
                                <div class="text-muted" style="font-size:11px">@p.Address@(!string.IsNullOrWhiteSpace(p.Address) && !string.IsNullOrWhiteSpace(p.State) ? ", " : "")@p.State</div>
                            }
                        </td>
                        <td class="text-muted small">
                            @if (!string.IsNullOrWhiteSpace(p.GSTNo)) { <div>GST: @p.GSTNo</div> }
                            @if (!string.IsNullOrWhiteSpace(p.FSSAINo))
                            {
                                <div>
                                    FSSAI: @p.FSSAINo
                                    @if (p.HasFssaiDocument)
                                    {
                                        <a href="@Url.Action("FssaiDocument", "Masters", new { ledgerId = p.LedgerId })" target="_blank" class="ms-1" title="View FSSAI document">
                                            <i class="bi bi-paperclip text-primary"></i>
                                        </a>
                                    }
                                </div>
                            }
                        </td>
                        <td class="text-muted small">@p.MobileNo</td>
                        <td>
                            <span class="badge bg-@statusBadge">@p.ApprovalStatus</span>
                            @if (p.ApprovalStatus == SaleOrd.Models.Domain.LedgerApprovalStatus.Rejected && !string.IsNullOrWhiteSpace(p.RejectionReason))
                            {
                                <div class="text-muted" style="font-size:11px">@p.RejectionReason</div>
                            }
                            @if (p.ApprovalStatus != SaleOrd.Models.Domain.LedgerApprovalStatus.Pending && p.ReviewedByName != null)
                            {
                                <div class="text-muted" style="font-size:11px">by @p.ReviewedByName</div>
                            }
                        </td>
                        <td class="d-none d-md-table-cell text-muted small">@p.LastSyncedAt.ToString("dd-MMM-yyyy hh:mm tt")</td>
                        <td class="d-none d-md-table-cell text-muted small">
                            @if (p.TallyPushedAt.HasValue)
                            {
                                @p.TallyPushedAt.Value.ToString("dd-MMM-yyyy hh:mm tt")
                            }
                            else if (p.ApprovalStatus == SaleOrd.Models.Domain.LedgerApprovalStatus.Approved)
                            {
                                <span class="badge bg-warning text-dark">Queued for Agent</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (p.ApprovalStatus == SaleOrd.Models.Domain.LedgerApprovalStatus.Pending)
                            {
                                <div class="d-flex justify-content-end gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#approveModal@(p.LedgerId)">
                                        <i class="bi bi-check-lg"></i> Approve
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#rejectModal@(p.LedgerId)">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Modals live outside .table-responsive on purpose — see SignupRequests.cshtml
   for why: overflow-x:auto ancestors break position:fixed modals on iOS
   Safari/WebKit specifically (desktop + Android Chrome, both Blink, are fine). *@
@foreach (var p in Model.Where(p => p.ApprovalStatus == SaleOrd.Models.Domain.LedgerApprovalStatus.Pending))
{
    <!-- Approve modal -->
    <div class="modal fade" id="approveModal@(p.LedgerId)" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-action="ApproveParty">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@p.LedgerId" />
                    <div class="modal-header">
                        <h6 class="modal-title">Approve @p.LedgerName</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="small mb-3 p-2 rounded-3" style="background:var(--bg)">
                            @if (!string.IsNullOrWhiteSpace(p.OutletName))
                            {
                                <div class="d-flex justify-content-between"><span class="text-muted">Outlet</span><span>@p.OutletName</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.GSTNo))
                            {
                                <div class="d-flex justify-content-between"><span class="text-muted">GST</span><span>@p.GSTNo</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.FSSAINo))
                            {
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">FSSAI</span>
                                    <span>
                                        @p.FSSAINo
                                        @if (p.HasFssaiDocument)
                                        {
                                            <a href="@Url.Action("FssaiDocument", "Masters", new { ledgerId = p.LedgerId })" target="_blank" class="ms-1" title="View FSSAI document">
                                                <i class="bi bi-paperclip text-primary"></i>
                                            </a>
                                        }
                                    </span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.MobileNo))
                            {
                                <div class="d-flex justify-content-between"><span class="text-muted">Contact</span><span>@p.MobileNo</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.Address))
                            {
                                <div class="d-flex justify-content-between"><span class="text-muted">Address</span><span class="text-end">@p.Address</span></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.State))
                            {
                                <div class="d-flex justify-content-between"><span class="text-muted">State</span><span>@p.State</span></div>
                            }
                        </div>
                        <div class="text-muted small">
                            This makes the party usable in Sale Orders immediately. It will be pushed to Tally as a new ledger master by the sync agent shortly after.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success btn-sm">Approve</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Reject modal -->
    <div class="modal fade" id="rejectModal@(p.LedgerId)" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-action="RejectParty">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@p.LedgerId" />
                    <div class="modal-header">
                        <h6 class="modal-title">Reject @p.LedgerName</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label small fw-semibold">Reason (optional)</label>
                        <textarea name="reason" class="form-control" rows="2" placeholder="Optional note"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
