@model SaleOrd.Models.ViewModels.UserEditVM
@{ ViewData["Title"] = "Edit User"; ViewData["ActivePage"] = "Users"; }
@{
    var companies = ViewBag.Companies as IEnumerable<SaleOrd.Models.Domain.Company> ?? Enumerable.Empty<SaleOrd.Models.Domain.Company>();
}

<div class="page-header">
    <div class="d-flex align-items-center gap-2">
        <a href="/Admin/Users" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h5>Edit User</h5>
            <div class="page-title-sub">@Model.Email</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <form method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

            <!-- Basic info -->
            <div class="card p-3 mb-3">
                <div class="card-header px-0 pt-0 mb-3" style="border-top:none">Basic Info</div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Email <span class="text-muted fw-normal">(login ID — cannot change)</span></label>
                    <input value="@Model.Email" class="form-control" disabled />
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password <span class="text-muted fw-normal">(leave blank to keep current)</span></label>
                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Min 6 chars" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <!-- Role selector -->
                <div>
                    <label class="form-label">Role</label>
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var role in new[] { ("Admin","Full access","bi-shield-fill-check","text-danger"), ("Manager","View all orders","bi-person-badge","text-primary"), ("Salesman","Create & view own","bi-person","text-success") })
                        {
                            <label class="role-option flex-grow-1" style="cursor:pointer">
                                <input type="radio" asp-for="Role" value="@role.Item1" class="d-none role-radio" />
                                <div class="card p-2 text-center role-card @(Model.Role == role.Item1 ? "selected" : "")" style="border-radius:10px;border:2px solid var(--border);transition:all .15s">
                                    <i class="bi @role.Item3 @role.Item4 mb-1" style="font-size:20px"></i>
                                    <div class="fw-semibold" style="font-size:12px">@role.Item1</div>
                                    <div class="text-muted" style="font-size:10px">@role.Item2</div>
                                </div>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <!-- Status -->
            <div class="card p-3 mb-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-semibold" style="font-size:13px">Account Status</div>
                        <small class="text-muted">Inactive users cannot log in</small>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" style="width:44px;height:22px;cursor:pointer" />
                    </div>
                </div>
            </div>

            <!-- Company access -->
            <div class="card p-3 mb-3">
                <div class="card-header px-0 pt-0 mb-3" style="border-top:none">
                    Company Access
                    <small class="text-muted fw-normal ms-1">— check companies this user can access</small>
                </div>
                <span asp-validation-for="CompanyIds" class="text-danger small d-block mb-2"></span>

                @foreach (var c in companies)
                {
                    bool isMapped  = Model.CompanyIds.Contains(c.CompanyId);
                    bool isDefault = Model.DefaultCompanyId == c.CompanyId;
                    <div class="d-flex align-items-center justify-content-between p-3 mb-2 rounded-3 company-access-row @(isMapped ? "selected" : "")"
                         style="border:1.5px solid @(isMapped ? "var(--primary)" : "var(--border)");background:@(isMapped ? "var(--primary-soft)" : "");cursor:pointer"
                         onclick="toggleCompany(@c.CompanyId, this)">
                        <div class="d-flex align-items-center gap-3">
                            <div style="width:36px;height:36px;background:#eef0ff;border-radius:10px;display:flex;align-items:center;justify-content:center">
                                <i class="bi bi-building text-primary"></i>
                            </div>
                            <div>
                                <div class="fw-semibold" style="font-size:13px">@c.CompanyName</div>
                                <small class="text-muted">@c.TallyCompanyName</small>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <label class="small text-muted me-1" onclick="event.stopPropagation()">Default</label>
                            <input type="radio" asp-for="DefaultCompanyId" value="@c.CompanyId"
                                   class="form-check-input default-radio"
                                   onclick="event.stopPropagation();markDefault(@c.CompanyId)"
                                   checked="@isDefault" />
                            <input type="checkbox" name="CompanyIds" value="@c.CompanyId"
                                   class="form-check-input company-checkbox" id="co_@c.CompanyId"
                                   onclick="event.stopPropagation();syncDefault(this, @c.CompanyId)"
                                   checked="@isMapped" />
                        </div>
                    </div>
                }
            </div>

            <div class="form-actions">
                <a href="/Admin/Users" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
            </div>
        </form>
    </div>

    <div class="col-lg-5 d-none d-lg-block">
        <div class="card p-3 border-0 bg-blue-soft">
            <div class="fw-semibold mb-2 small"><i class="bi bi-info-circle text-primary me-1"></i>Company Access</div>
            <p class="small text-muted mb-2">Salesman and Manager see only their mapped companies. Admin sees all companies by default.</p>
            <p class="small text-muted mb-0"><strong>Default company</strong> is what opens when user logs in.</p>
        </div>

        <div class="card p-3 mt-3">
            <div class="fw-semibold mb-2 small">Access Summary</div>
            <div id="accessSummary" class="text-muted small">
                @(Model.CompanyIds.Any()
                    ? $"{Model.CompanyIds.Count} company(s) selected"
                    : "No companies selected")
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// Role card highlight
document.querySelectorAll('.role-radio').forEach(r => {
    r.addEventListener('change', () => {
        document.querySelectorAll('.role-card').forEach(c => {
            c.style.borderColor = 'var(--border)';
            c.classList.remove('selected');
        });
        r.closest('.role-option').querySelector('.role-card').style.borderColor = 'var(--primary)';
        r.closest('.role-option').querySelector('.role-card').classList.add('selected');
    });
    if (r.checked) r.dispatchEvent(new Event('change'));
});

function toggleCompany(id, row) {
    var cb = document.getElementById('co_' + id);
    cb.checked = !cb.checked;
    row.style.borderColor = cb.checked ? 'var(--primary)' : 'var(--border)';
    row.style.background  = cb.checked ? 'var(--primary-soft)' : '';
    if (!cb.checked) {
        var radios = document.querySelectorAll('.default-radio');
        radios.forEach(r => { if (r.value == id) r.checked = false; });
    }
    updateSummary();
}

function markDefault(id) {
    var cb = document.getElementById('co_' + id);
    if (!cb.checked) { cb.checked = true; syncDefault(cb, id); }
}

function syncDefault(cb, id) {
    if (!cb.checked) {
        var radios = document.querySelectorAll('.default-radio');
        radios.forEach(r => { if (r.value == id) r.checked = false; });
    }
    updateSummary();
}

function updateSummary() {
    var checked = document.querySelectorAll('.company-checkbox:checked');
    var names = [];
    checked.forEach(cb => {
        var row = cb.closest('.company-access-row');
        if (row) names.push(row.querySelector('.fw-semibold')?.textContent?.trim());
    });
    document.getElementById('accessSummary').textContent = names.length
        ? names.join(', ')
        : 'No companies selected';
}
</script>
}
