@{ ViewData["Title"] = "Sales Summary"; ViewData["ActivePage"] = "ReportsSummary"; }

<div class="page-header mb-3">
    <h5><i class="bi bi-bar-chart-line me-2 text-primary"></i>Sales Summary</h5>
</div>

<!-- Date filter -->
<div class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-5 col-md-3">
            <label class="form-label small mb-1">From</label>
            <input type="date" id="rptFrom" class="form-control form-control-sm"
                   value="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-5 col-md-3">
            <label class="form-label small mb-1">To</label>
            <input type="date" id="rptTo" class="form-control form-control-sm"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-2 col-md-1">
            <button class="btn btn-primary btn-sm w-100" onclick="loadData()">
                <i class="bi bi-funnel"></i>
            </button>
        </div>
    </div>
</div>

<!-- Stat cards -->
<div class="row g-2 mb-3" id="statsRow">
    <div class="col-12 text-center text-muted py-4 small"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</div>
</div>

<!-- Order Details table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
        <span class="fw-semibold small"><i class="bi bi-list-ul me-1"></i>Order Details</span>
        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="width:220px">
                <span class="input-group-text bg-transparent py-0"><i class="bi bi-search"></i></span>
                <input type="text" id="orderSearch" class="form-control" placeholder="Search order no / party..." />
            </div>
            @if ((bool)ViewBag.CanExport)
            {
                <button class="btn btn-outline-success btn-sm border-0 p-0 px-2" onclick="exportTable('recentTable','Order_Details')" title="Export CSV (current page)">
                    <i class="bi bi-file-earmark-excel-fill text-success"></i>
                </button>
            }
        </div>
    </div>
    <div id="tableWrap">
        <div id="tableLoading" class="text-center py-4 text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</div>
        <div class="table-responsive" id="tableContent" style="display:none">
            <table class="table table-sm mb-0" id="recentTable">
                <thead class="table-light">
                    <tr><th>SO No</th><th>Date</th><th>Party</th><th class="text-end">Amount</th><th>Status</th><th>Invoice</th></tr>
                </thead>
                <tbody id="tableBody"></tbody>
            </table>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center py-2" id="ordersFooter" style="display:none">
        <span class="text-muted small" id="ordersCount"></span>
        <nav>
            <ul class="pagination pagination-sm mb-0" id="ordersPagination"></ul>
        </nav>
    </div>
</div>

@section Scripts {
<script>
var orderSearchTimer;

$(function() {
    loadData();
    $('#orderSearch').on('input', function() {
        clearTimeout(orderSearchTimer);
        orderSearchTimer = setTimeout(function() { loadOrders(1); }, 350);
    });
});

// Re-runs both the stat cards and the Order Details grid — used by the
// date-range Filter button, which invalidates both.
function loadData() {
    loadStats();
    loadOrders(1);
}

function loadStats() {
    var params = { from: $('#rptFrom').val(), to: $('#rptTo').val() };
    $('#statsRow').html('<div class="col-12 text-center text-muted py-4 small"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</div>');

    $.get('/Reports/SummaryData', params, function(d) {
        var stats = [
            { label: 'Total Orders', val: d.totalOrders, cls: 'text-primary', icon: 'bi-file-earmark-text' },
            { label: 'Total Value',  val: '₹' + fmt(d.totalValue), cls: 'text-dark', icon: 'bi-currency-rupee' },
            { label: 'Synced',       val: d.syncedCount,   cls: 'text-success', icon: 'bi-check-circle' },
            { label: 'Pending',      val: d.pendingCount,  cls: 'text-warning', icon: 'bi-clock-history' },
            { label: 'Error',        val: d.errorCount,    cls: 'text-danger',  icon: 'bi-exclamation-circle' },
            { label: 'Invoiced',     val: d.invoicedCount, cls: 'text-info',    icon: 'bi-receipt' },
        ];
        var html = '';
        stats.forEach(function(s) {
            html += '<div class="col-6 col-md-4 col-lg-2">' +
                '<div class="card stat-card p-3 h-100">' +
                '<div class="small text-muted mb-1"><i class="bi ' + s.icon + ' me-1"></i>' + s.label + '</div>' +
                '<div class="fs-5 fw-bold ' + s.cls + '">' + s.val + '</div>' +
                '</div></div>';
        });
        $('#statsRow').html(html);
    }).fail(function() {
        $('#statsRow').html('<div class="col-12"><div class="alert alert-danger">Failed to load data.</div></div>');
    });
}

// Server-side paginated + searched — unlike the old fixed Take(10), every
// order in the selected date range is reachable, just a page at a time.
function loadOrders(page) {
    var params = { from: $('#rptFrom').val(), to: $('#rptTo').val(), q: $('#orderSearch').val(), page: page || 1 };
    $('#tableLoading').show(); $('#tableContent').hide(); $('#ordersFooter').hide();

    $.get('/Reports/SummaryOrdersData', params, function(d) {
        var rows = '';
        if (!d.orders || !d.orders.length) {
            rows = '<tr><td colspan="6" class="text-center text-muted py-3">No orders found.</td></tr>';
        } else {
            d.orders.forEach(function(o) {
                var sc = { Cancelled:'badge-cancelled', Pending:'badge-pending', Synced:'badge-synced', Invoiced:'badge-invoiced', Error:'badge-error' }[o.status] || 'badge-cancelled';
                rows += '<tr>' +
                    '<td class="small"><a href="/SaleOrder/Details/' + o.saleOrderId + '">' + esc(o.orderNo) + '</a></td>' +
                    '<td class="small">' + esc(o.orderDate) + '</td>' +
                    '<td class="small">' + esc(o.ledgerName) + '</td>' +
                    '<td class="text-end small fw-semibold">₹' + fmt(o.total) + '</td>' +
                    '<td><span class="badge ' + sc + '">' + o.status + '</span></td>' +
                    '<td class="small">' + (o.isInvoiced ? '<span class="text-success">' + esc(o.tallyInvoiceNo || 'Yes') + '</span>' : '—') + '</td>' +
                    '</tr>';
            });
        }
        $('#tableBody').html(rows);
        $('#tableLoading').hide(); $('#tableContent').show();

        renderPagination(d.total, d.page, d.pageSize);
    }).fail(function() {
        $('#tableLoading').html('<span class="text-danger small">Failed to load.</span>');
    });
}

function renderPagination(total, page, pageSize) {
    if (!total) { $('#ordersFooter').hide(); return; }
    var totalPages = Math.ceil(total / pageSize);
    var from = (page - 1) * pageSize + 1;
    var to = Math.min(page * pageSize, total);
    $('#ordersCount').text(from + '–' + to + ' of ' + total + ' order' + (total > 1 ? 's' : ''));

    var html = '';
    for (var p = 1; p <= totalPages; p++) {
        html += '<li class="page-item ' + (p === page ? 'active' : '') + '">' +
            '<a class="page-link" href="#" onclick="loadOrders(' + p + ');return false;">' + p + '</a></li>';
    }
    $('#ordersPagination').html(html);
    $('#ordersFooter').show();
}

function exportTable(tableId, filename) {
    var table = document.getElementById(tableId);
    if (!table) return;
    var csv = [];
    table.querySelectorAll('tr').forEach(function(row) {
        var r = [];
        row.querySelectorAll('td,th').forEach(function(cell) {
            r.push('"' + cell.innerText.trim().replace(/₹/g,'').replace(/"/g,'""') + '"');
        });
        if (r.length) csv.push(r.join(','));
    });
    var a = document.createElement('a');
    a.href = 'data:text/csv;charset=utf-8,﻿' + encodeURI(csv.join('\n'));
    a.download = filename + '.csv';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
}

function fmt(n) { return (n||0).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function esc(s) { var d=document.createElement('div'); d.textContent=s||''; return d.innerHTML; }
</script>
}
