@{ ViewData["Title"] = "Order vs Invoice"; ViewData["ActivePage"] = "ReportsTransactionCompare"; }

<div class="page-header mb-3">
    <h5><i class="bi bi-arrow-left-right me-2 text-primary"></i>Order vs Invoice</h5>
    <div class="page-title-sub">Line-by-line compare of what was ordered vs what actually got invoiced in Tally</div>
</div>

<div class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-5 col-md-3">
            <label class="form-label small mb-1">From</label>
            <input type="date" id="rptFrom" class="form-control form-control-sm"
                   value="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-5 col-md-3">
            <label class="form-label small mb-1">To</label>
            <input type="date" id="rptTo" class="form-control form-control-sm"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-2 col-md-1">
            <button class="btn btn-primary btn-sm w-100" onclick="loadData()">
                <i class="bi bi-funnel"></i>
            </button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold small">
            <i class="bi bi-list-ul me-1"></i>Invoiced Orders
            <span class="badge bg-primary ms-2" id="orderBadge" style="display:none"></span>
        </span>
        @if ((bool)ViewBag.CanExport)
        {
            <button class="btn btn-outline-success btn-sm border-0 p-0 px-2" onclick="exportTable('compareTable','Order_vs_Invoice')" title="Export CSV">
                <i class="bi bi-file-earmark-excel-fill text-success"></i>
            </button>
        }
    </div>
    <div id="tableLoading" class="text-center py-4 text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</div>
    <div class="table-responsive" id="tableContent" style="display:none">
        <table class="table table-sm mb-0" id="compareTable">
            <thead class="table-light">
                <tr>
                    <th>SO No</th><th>Order Date</th><th>Party</th><th>Invoice No</th><th>Invoice Date</th>
                    <th>Item</th>
                    <th class="text-end">Ordered Qty</th><th class="text-end">Ordered Rate</th><th class="text-end">Ordered Amt</th>
                    <th class="text-end">Invoiced Qty</th><th class="text-end">Invoiced Rate</th><th class="text-end">Invoiced Amt</th>
                    <th>Match</th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
        </table>
    </div>
</div>

<div class="text-muted small mt-2">
    <i class="bi bi-info-circle me-1"></i>
    An item showing "Not synced" hasn't necessarily gone wrong in Tally — it means the Rates sync (Config &gt; Sync Rates,
    or the manual "Sync Rates" button in the agent) hasn't pulled that invoice's line items in yet.
</div>

@section Scripts {
<script>
$(function() { loadData(); });

function loadData() {
    var params = { from: $('#rptFrom').val(), to: $('#rptTo').val() };
    $('#tableLoading').show(); $('#tableContent').hide();
    $('#orderBadge').hide();

    $.get('/Reports/TransactionCompareData', params, function(data) {
        if (data.length) $('#orderBadge').text(data.length + ' order' + (data.length > 1 ? 's' : '')).show();
        var html = '';
        if (!data.length) {
            html = '<tr><td colspan="13" class="text-center text-muted py-4">No invoiced orders in this range.</td></tr>';
        } else {
            data.forEach(function(o) {
                if (!o.items.length) {
                    html += rowHtml(o, null);
                    return;
                }
                o.items.forEach(function(it) { html += rowHtml(o, it); });
            });
        }
        $('#tableBody').html(html);
        $('#tableLoading').hide(); $('#tableContent').show();
    }).fail(function() {
        $('#tableLoading').html('<span class="text-danger small">Failed to load.</span>');
    });
}

function rowHtml(o, it) {
    var matchCell = '<span class="text-muted small">—</span>';
    var itemCells = '<td class="small text-muted">(no items)</td>' +
        '<td class="text-end small">—</td><td class="text-end small">—</td><td class="text-end small">—</td>' +
        '<td class="text-end small">—</td><td class="text-end small">—</td><td class="text-end small">—</td>';

    if (it) {
        if (it.matched) {
            var qtyOff = Math.abs((it.qtyDiff || 0)) > 0.001;
            var amtOff = Math.abs((it.amtDiff || 0)) > 0.01;
            matchCell = (qtyOff || amtOff)
                ? '<span class="badge badge-error">Diff</span>'
                : '<span class="badge badge-synced">Match</span>';
        } else {
            matchCell = '<span class="badge badge-pending">Not synced</span>';
        }
        itemCells = '<td class="small">' + esc(it.itemName) + '</td>' +
            '<td class="text-end small">' + fmtQty(it.orderedQty) + '</td>' +
            '<td class="text-end small">₹' + fmt(it.orderedRate) + '</td>' +
            '<td class="text-end small">₹' + fmt(it.orderedAmt) + '</td>' +
            '<td class="text-end small' + (it.matched ? '' : ' text-muted') + '">' + (it.matched ? fmtQty(it.invoicedQty) : '—') + '</td>' +
            '<td class="text-end small' + (it.matched ? '' : ' text-muted') + '">' + (it.matched ? ('₹' + fmt(it.invoicedRate)) : '—') + '</td>' +
            '<td class="text-end small' + (it.matched ? '' : ' text-muted') + '">' + (it.matched ? ('₹' + fmt(it.invoicedAmt)) : '—') + '</td>';
    }

    return '<tr>' +
        '<td class="small"><a href="/SaleOrder/Details/' + o.saleOrderId + '">' + esc(o.orderNo) + '</a></td>' +
        '<td class="small">' + fmtDate(o.orderDate) + '</td>' +
        '<td class="small">' + esc(o.ledgerName) + '</td>' +
        '<td class="small">' + esc(o.invoiceNo || '—') + '</td>' +
        '<td class="small">' + fmtDate(o.invoiceDate) + '</td>' +
        itemCells +
        '<td>' + matchCell + '</td>' +
        '</tr>';
}

function exportTable(tableId, filename) {
    var table = document.getElementById(tableId); if (!table) return;
    var csv = [];
    table.querySelectorAll('tr').forEach(function(row) {
        var r = []; row.querySelectorAll('td,th').forEach(function(c) { r.push('"' + c.innerText.trim().replace(/₹/g,'').replace(/"/g,'""') + '"'); });
        if (r.length) csv.push(r.join(','));
    });
    var a = document.createElement('a'); a.href = 'data:text/csv;charset=utf-8,﻿' + encodeURI(csv.join('\n'));
    a.download = filename + '.csv'; document.body.appendChild(a); a.click(); document.body.removeChild(a);
}

function fmt(n) { return (n||0).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function fmtQty(n) { return (n||0).toLocaleString('en-IN',{minimumFractionDigits:0,maximumFractionDigits:3}); }
function fmtDate(s) { if (!s) return '—'; var d = new Date(s); return d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'2-digit'}); }
function esc(s) { var d=document.createElement('div'); d.textContent=s||''; return d.innerHTML; }
</script>
}
