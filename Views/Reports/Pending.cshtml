@{ ViewData["Title"] = "Pending Orders"; ViewData["ActivePage"] = "ReportsPending"; }

<div class="page-header mb-3">
    <h5><i class="bi bi-clock-history me-2 text-warning"></i>Pending Orders</h5>
</div>

<div class="card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-5 col-md-3">
            <label class="form-label small mb-1">From</label>
            <input type="date" id="rptFrom" class="form-control form-control-sm"
                   value="@(new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-5 col-md-3">
            <label class="form-label small mb-1">To</label>
            <input type="date" id="rptTo" class="form-control form-control-sm"
                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-2 col-md-1">
            <button class="btn btn-primary btn-sm w-100" onclick="loadData()">
                <i class="bi bi-funnel"></i>
            </button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <span class="fw-semibold small">
            <i class="bi bi-clock-history me-1"></i>Pending / Error Orders
            <span class="badge bg-warning text-dark ms-2" id="pendingBadge" style="display:none"></span>
        </span>
        @if ((bool)ViewBag.CanExport)
        {
            <button class="btn btn-outline-success btn-sm border-0 p-0 px-2" onclick="exportTable('pendingTable','Pending_Orders')" title="Export CSV">
                <i class="bi bi-file-earmark-excel-fill text-success"></i>
            </button>
        }
    </div>
    <div id="tableLoading" class="text-center py-4 text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Loading...</div>
    <div class="table-responsive" id="tableContent" style="display:none">
        <table class="table table-sm mb-0" id="pendingTable">
            <thead class="table-light">
                <tr><th>SO No</th><th>Date</th><th>Party</th><th class="text-end">Amount</th><th>Status</th><th>By</th><th>Error</th></tr>
            </thead>
            <tbody id="tableBody"></tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
$(function() { loadData(); });

function loadData() {
    var params = { from: $('#rptFrom').val(), to: $('#rptTo').val() };
    $('#tableLoading').show(); $('#tableContent').hide();
    $('#pendingBadge').hide();

    $.get('/Reports/PendingData', params, function(data) {
        if (data.length) $('#pendingBadge').text(data.length).show();
        var html = '';
        if (!data.length) {
            html = '<tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-check-circle text-success me-1"></i>No pending orders — all good!</td></tr>';
        } else {
            data.forEach(function(r) {
                var sc = r.status === 'Error' ? 'badge-error' : 'badge-pending';
                html += '<tr>' +
                    '<td class="small"><a href="/SaleOrder/Details/' + r.saleOrderId + '">' + esc(r.orderNo) + '</a></td>' +
                    '<td class="small">' + fmtDate(r.orderDate) + '</td>' +
                    '<td class="small">' + esc(r.ledgerName) + '</td>' +
                    '<td class="text-end small fw-semibold">₹' + fmt(r.total) + '</td>' +
                    '<td><span class="badge ' + sc + '">' + r.status + '</span></td>' +
                    '<td class="small">' + esc(r.createdByName) + '</td>' +
                    '<td class="small text-danger" style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="' + esc(r.syncError||'') + '">' + esc(r.syncError || '—') + '</td>' +
                    '</tr>';
            });
        }
        $('#tableBody').html(html);
        $('#tableLoading').hide(); $('#tableContent').show();
    }).fail(function() {
        $('#tableLoading').html('<span class="text-danger small">Failed to load.</span>');
    });
}

function exportTable(tableId, filename) {
    var table = document.getElementById(tableId); if (!table) return;
    var csv = [];
    table.querySelectorAll('tr').forEach(function(row) {
        var r = []; row.querySelectorAll('td,th').forEach(function(c) { r.push('"' + c.innerText.trim().replace(/₹/g,'').replace(/"/g,'""') + '"'); });
        if (r.length) csv.push(r.join(','));
    });
    var a = document.createElement('a'); a.href = 'data:text/csv;charset=utf-8,﻿' + encodeURI(csv.join('\n'));
    a.download = filename + '.csv'; document.body.appendChild(a); a.click(); document.body.removeChild(a);
}

function fmt(n) { return (n||0).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function fmtDate(s) { if (!s) return '—'; var d = new Date(s); return d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'2-digit'}); }
function esc(s) { var d=document.createElement('div'); d.textContent=s||''; return d.innerHTML; }
</script>
}
