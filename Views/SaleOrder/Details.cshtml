@model SaleOrd.Models.Domain.SaleOrder
@{ ViewData["Title"] = "Order Details"; }

@section Styles {
<style>
@@media print {
    .navbar, .bottom-nav, .offcanvas, .no-print { display: none !important; }
    main { padding: 0 !important; max-width: 100% !important; }
    .card { box-shadow: none !important; border: 1px solid #ddd !important; }
    body { background: white !important; }
}
</style>
}

@{
    // A Synced order that's since been invoiced in Tally reads as
    // "Invoiced", not "Synced" — same rule as the order list/dashboard.
    string statusLabel = Model.Status == SaleOrd.Models.Domain.OrderStatus.Synced && Model.IsInvoiced
        ? "Invoiced" : Model.Status.ToString();
    string statusClass = statusLabel switch
    {
        "Pending"  => "warning",
        "Synced"   => "success",
        "Invoiced" => "primary",
        "Error"    => "danger",
        _          => "secondary"
    };
}

<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="/SaleOrder" class="btn btn-sm btn-link p-0 me-2 text-dark no-print"><i class="bi bi-arrow-left fs-5"></i></a>
        <div>
            <h5 class="mb-0">@Model.OrderNo</h5>
            <small class="text-muted">@Model.OrderDate.ToString("dd MMM yyyy")</small>
        </div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge bg-@statusClass">@statusLabel</span>
        @if ((bool)ViewBag.CanPrint)
        {
            <a href="/SaleOrder/Print/@Model.SaleOrderId" target="_blank" class="btn btn-sm btn-outline-secondary no-print" title="Print">
                <i class="bi bi-printer"></i>
            </a>
        }
    </div>
</div>

<div class="card p-3 mb-3">
    <div class="row g-2">
        <div class="col-6">
            <div class="small text-muted">Party</div>
            <div class="fw-semibold">@Model.LedgerName</div>
        </div>
        <div class="col-6">
            <div class="small text-muted">Created By</div>
            <div>@Model.CreatedByName</div>
        </div>
        @if (Model.DeliveryDate.HasValue)
        {
            <div class="col-6">
                <div class="small text-muted">Delivery Date</div>
                <div>@Model.DeliveryDate.Value.ToString("dd MMM yyyy")</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.TallyVoucherNo))
        {
            <div class="col-6">
                <div class="small text-muted">Tally Voucher</div>
                <div class="fw-semibold text-success">@Model.TallyVoucherNo</div>
            </div>
        }
        @if (Model.SyncedAt.HasValue)
        {
            <div class="col-6">
                <div class="small text-muted">Synced At</div>
                <div class="small">@Model.SyncedAt.Value.ToString("dd MMM, h:mm tt")</div>
            </div>
        }
        @if (Model.IsInvoiced)
        {
            <div class="col-6">
                <div class="small text-muted">Invoice</div>
                <div class="fw-semibold text-primary">@Model.TallyInvoiceNo
                    @if (Model.TallyInvoiceDate.HasValue)
                    { <span class="text-muted fw-normal small">(@Model.TallyInvoiceDate.Value.ToString("dd-MMM-yy"))</span> }
                </div>
            </div>
        }
        @if (Model.EditDeadline.HasValue && !Model.IsInvoiced)
        {
            bool editable = DateTime.Now <= Model.EditDeadline.Value;
            <div class="col-12">
                <div class="small text-muted">Edit Window</div>
                <div class="small @(editable ? "text-success" : "text-danger")">
                    <i class="bi bi-@(editable ? "pencil" : "lock-fill") me-1"></i>
                    @(editable ? "Editable until" : "Closed since") @Model.EditDeadline.Value.ToString("dd-MMM-yy hh:mm tt")
                </div>
            </div>
        }
    </div>
    @if (!string.IsNullOrEmpty(Model.Narration))
    {
        <div class="mt-2 pt-2 border-top">
            <div class="small text-muted">Narration</div>
            <div class="small">@Model.Narration</div>
        </div>
    }
    @if (Model.IsInvoiced)
    {
        <div class="alert alert-success mt-2 mb-0 py-2 small">
            <i class="bi bi-check-circle-fill me-1"></i>This order has been invoiced in Tally. It cannot be edited.
        </div>
    }
    @if (Model.Status.ToString() == "Error" && !string.IsNullOrEmpty(Model.SyncError))
    {
        <div class="alert alert-danger mt-2 mb-0 py-2 small">
            <i class="bi bi-exclamation-triangle me-1"></i>@Model.SyncError
        </div>
    }
</div>

<!-- Items table -->
<div class="card mb-3">
    <div class="card-header py-2 fw-semibold small">Items</div>
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead class="table-light">
                <tr>
                    <th>Item</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Rate</th>
                    <th class="text-end">Disc%</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div>@item.ItemName</div>
                            <small class="text-muted">@item.UOM@(item.GodownName != null ? " · " + item.GodownName : "")</small>
                        </td>
                        <td class="text-end">@item.Qty.ToString("N3")</td>
                        <td class="text-end">@item.Rate.ToString("N2")</td>
                        <td class="text-end">@item.Discount.ToString("N2")</td>
                        <td class="text-end fw-semibold">₹@item.Amount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <td colspan="4" class="text-end">Sub Total</td>
                    <td class="text-end fw-semibold">₹@Model.TotalAmount.ToString("N2")</td>
                </tr>
                @if (Model.TaxType != "None" && Model.TaxTotal > 0)
                {
                    @if (Model.IGSTTotal > 0)
                    {
                        <tr>
                            <td colspan="4" class="text-end text-muted small">IGST (@Model.TaxPercent%)</td>
                            <td class="text-end small">₹@Model.IGSTTotal.ToString("N2")</td>
                        </tr>
                    }
                    @if (Model.CGSTTotal > 0)
                    {
                        <tr>
                            <td colspan="4" class="text-end text-muted small">CGST (@(Model.TaxPercent/2)%)</td>
                            <td class="text-end small">₹@Model.CGSTTotal.ToString("N2")</td>
                        </tr>
                    }
                    @if (Model.SGSTTotal > 0)
                    {
                        <tr>
                            <td colspan="4" class="text-end text-muted small">SGST (@(Model.TaxPercent/2)%)</td>
                            <td class="text-end small">₹@Model.SGSTTotal.ToString("N2")</td>
                        </tr>
                    }
                    @if (Model.RoundOff != 0)
                    {
                        <tr>
                            <td colspan="4" class="text-end text-muted small">Round Off</td>
                            <td class="text-end small">₹@Model.RoundOff.ToString("N2")</td>
                        </tr>
                    }
                }
                <tr class="table-primary">
                    <td colspan="4" class="text-end fw-bold">Grand Total</td>
                    <td class="text-end fw-bold">₹@((Model.GrandTotal > 0 ? Model.GrandTotal : Model.TotalAmount).ToString("N2"))</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Actions -->
@{
    // Error orders can always be edited regardless of the deadline — that's
    // the only recovery path now (there's no separate "Resubmit" button;
    // editing an order already resets it to Pending on save, so the sync
    // agent picks it up on its next cycle).
    bool canEditNow = !Model.IsInvoiced
        && (Model.Status.ToString() == "Error"
            || Model.EditDeadline == null
            || DateTime.Now <= Model.EditDeadline.Value);
}
<div class="form-actions">
    @if (canEditNow)
    {
        <a href="/SaleOrder/Edit/@Model.SaleOrderId" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
    }
    @if (!Model.IsInvoiced)
    {
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelOrderModal">
            <i class="bi bi-x-circle me-1"></i>Cancel Order
        </button>
    }
</div>

<div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancel order?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">
                    @(Model.Status.ToString() == "Synced"
                        ? "This order has already been synced to Tally — cancelling it here will also cancel the corresponding voucher in Tally."
                        : "This order will be marked as cancelled.")
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">No</button>
                <form method="post" asp-action="Cancel" asp-route-id="@Model.SaleOrderId" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i>Yes, Cancel
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
