@model SaleOrd.Models.ViewModels.SaleOrderCreateVM
@{ 
    ViewData["Title"] = Model.SaleOrderId > 0 ? "Edit Sale Order" : "New Sale Order"; 
}

<div class="page-header">
    <div class="d-flex align-items-center">
        <a href="/SaleOrder" class="btn btn-sm btn-link p-0 me-2 text-dark"><i class="bi bi-arrow-left fs-5"></i></a>
        <h5>@(Model.SaleOrderId > 0 ? "Edit Sale Order" : "New Sale Order")</h5>
    </div>
</div>

<form id="orderForm" method="post" action="@(Model.SaleOrderId > 0 ? $"/SaleOrder/Edit/{Model.SaleOrderId}" : "/SaleOrder/Create")">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

    <div class="card p-3 mb-3">
        <label class="form-label fw-semibold">Party / Customer <span class="text-danger">*</span></label>
        <input type="hidden" asp-for="LedgerId" id="ledgerIdInput" />
        <input type="hidden" asp-for="LedgerName" id="ledgerNameInput" />
        <div class="input-group" id="partySearchWrap">
            <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
            <input type="text" id="partySearch" class="form-control" placeholder="Search party name..." autocomplete="off" />
        </div>
        <div id="partyDropdown" class="list-group shadow-sm" style="display:none;position:absolute;z-index:9999;width:calc(100% - 32px);max-height:200px;overflow-y:auto;margin-top:42px"></div>
        <div id="selectedParty" class="mt-2" style="display:none">
            <span class="badge bg-primary p-2" id="selectedPartyName" style="white-space: normal; text-align: left;"></span>
            <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2" onclick="clearParty()"><i class="bi bi-x-circle-fill fs-6"></i></button>
        </div>
    </div>

    <div class="card p-3 mb-3">
        <div class="row g-2">
            <div class="col-6">
                <label class="form-label fw-semibold">Order Date <span class="text-danger">*</span></label>
                <input asp-for="OrderDate" type="date" class="form-control" />
            </div>
            <div class="col-6">
                <label class="form-label fw-semibold">Delivery Date</label>
                <input asp-for="DeliveryDate" type="date" class="form-control" />
            </div>
        </div>
    </div>

    <!-- Order Items Section -->
    <div class="card p-3 mb-3">
        <div class="fw-semibold mb-3">Order Items</div>
        
        <!-- Item entry fields -->
        <div class="row g-2 mb-3 align-items-end p-3 bg-light rounded border position-relative">
            <!-- Hidden inputs for current selected item in inputs -->
            <input type="hidden" id="entryItemId" />
            <input type="hidden" id="entryItemName" />
            <input type="hidden" id="entryItemUOM" />
            <input type="hidden" id="entryItemCGST" value="0" />
            <input type="hidden" id="entryItemSGST" value="0" />
            <input type="hidden" id="entryItemIGST" value="0" />
            <input type="hidden" id="editingIndex" value="" />

            <div class="col-12 col-md-4 position-relative">
                <label class="form-label small fw-semibold mb-1">Select Stock Item <span class="text-danger">*</span></label>
                <div class="input-group input-group-sm" id="itemSearchWrap">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" id="entryItemSearch" class="form-control form-control-sm" placeholder="Type to search stock item..." autocomplete="off" />
                </div>
                <!-- Dropdown list for item search -->
                <div id="entryItemDropdown" class="list-group shadow-sm" style="display:none;position:absolute;z-index:9999;width:calc(100% - 16px);max-height:180px;overflow-y:auto;margin-top:2px"></div>
                <!-- Selected item indicator -->
                <div id="entryItemSelectedLabel" class="mt-1" style="display:none">
                    <span class="badge bg-secondary p-2" id="entryItemSelectedName" style="white-space: normal; text-align: left; font-size: 0.85rem;"></span>
                    <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2" onclick="clearEntryItem()"><i class="bi bi-x-circle-fill fs-6"></i></button>
                </div>
            </div>

            <div class="col-4 col-md-2">
                <label class="form-label small fw-semibold mb-1">Quantity <span class="text-danger">*</span></label>
                <input type="number" id="entryQty" class="form-control form-control-sm text-end" min="0" step="0.001" placeholder="0.000" />
            </div>

            <div class="col-4 col-md-2">
                <label class="form-label small fw-semibold mb-1">Rate <span class="text-danger">*</span></label>
                <input type="number" id="entryRate" class="form-control form-control-sm text-end" min="0" step="0.01" placeholder="0.00" title="Auto-filled from this customer's last rate for the item — editable" />
            </div>

            <div class="col-4 col-md-1">
                <label class="form-label small fw-semibold mb-1">Disc %</label>
                <input type="number" id="entryDiscount" class="form-control form-control-sm text-end" min="0" max="100" step="0.01" placeholder="0.00" />
            </div>

            <div class="col-12 col-md-2 d-flex gap-1 justify-content-end">
                <button type="button" id="btnCancelEdit" class="btn btn-sm btn-outline-secondary w-100" style="display:none" onclick="cancelEditItem()" title="Cancel Edit">
                    <i class="bi bi-x-lg"></i>
                </button>
                <button type="button" id="btnAddItem" class="btn btn-sm btn-primary w-100" onclick="addOrUpdateItem()" title="Add to List">
                    <i class="bi bi-plus-lg"></i> Add
                </button>
            </div>
        </div>

        <!-- Items Table (Desktop View) -->
        <div class="table-responsive d-none d-md-block">
            <table class="table table-bordered table-hover table-sm align-middle" id="itemsTable">
                <thead class="table-light small">
                    <tr>
                        <th style="width: 5%" class="text-center">#</th>
                        <th>Item Details</th>
                        <th class="text-end" style="width: 13%">Qty</th>
                        <th class="text-end" style="width: 13%">Rate</th>
                        <th class="text-end" style="width: 10%">Disc%</th>
                        <th class="text-end" style="width: 14%">Amount</th>
                        <th class="text-center" style="width: 12%">Actions</th>
                    </tr>
                </thead>
                <tbody id="itemsTableBody" class="small">
                    <!-- Rows dynamically added by JS -->
                </tbody>
                <tfoot>
                    <tr class="fw-semibold bg-light">
                        <td colspan="5" class="text-end">Sub Total:</td>
                        <td class="text-end text-secondary fw-bold" id="grandTotalLabel">₹ 0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Items Cards (Mobile View) -->
        <div class="d-block d-md-none" id="itemsMobileContainer">
            <!-- Cards dynamically added by JS -->
        </div>

        <!-- Grand Total (Mobile View) -->
        <div class="card mb-3 border-0 bg-primary bg-gradient text-white shadow-sm d-block d-md-none" id="grandTotalMobileCard" style="display: none !important;">
            <div class="card-body d-flex justify-content-between align-items-center py-2 px-3">
                <span class="fw-semibold">Grand Total:</span>
                <span class="fs-5 fw-bold" id="grandTotalLabelMobile">₹ 0.00</span>
            </div>
        </div>

        <!-- Hidden Inputs for Model Binding -->
        <div id="hiddenItemsInputs"></div>
    </div>

    <!-- Tax & Totals Section -->
    <div class="card p-3 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fw-semibold">Totals</span>
            @if ((string)(ViewBag.DefaultTaxType ?? "None") != "None")
            {
                <span class="badge bg-info text-dark">@ViewBag.DefaultTaxType — rate per item master</span>
            }
        </div>

        <input type="hidden" asp-for="TaxType"    id="hidTaxType" />
        <input type="hidden" asp-for="TaxPercent" id="hidTaxPercent" />
        <input type="hidden" asp-for="TaxTotal"   id="hidTaxTotal" />
        <input type="hidden" asp-for="RoundOff"   id="hidRoundOff" />
        <input type="hidden" asp-for="GrandTotal" id="hidGrandTotal" />
        <input type="hidden" id="taxTypeSelect"   value="@ViewBag.DefaultTaxType" />

        <table class="table table-sm table-borderless mb-0 ms-auto" style="max-width:320px">
            <tbody>
                <tr>
                    <td class="text-end text-muted small">Sub Total:</td>
                    <td class="text-end fw-semibold" style="width:140px" id="lblSubTotal">₹ 0.00</td>
                </tr>
                <tr id="rowIGST" style="display:none">
                    <td class="text-end text-muted small" id="lblIGSTLabel">IGST (0%):</td>
                    <td class="text-end" id="lblIGSTAmt">₹ 0.00</td>
                </tr>
                <tr id="rowCGST" style="display:none">
                    <td class="text-end text-muted small" id="lblCGSTLabel">CGST (0%):</td>
                    <td class="text-end" id="lblCGSTAmt">₹ 0.00</td>
                </tr>
                <tr id="rowSGST" style="display:none">
                    <td class="text-end text-muted small" id="lblSGSTLabel">SGST (0%):</td>
                    <td class="text-end" id="lblSGSTAmt">₹ 0.00</td>
                </tr>
                <tr id="rowRoundOff" style="display:none">
                    <td class="text-end text-muted small">Round Off:</td>
                    <td class="text-end" id="lblRoundOff">₹ 0.00</td>
                </tr>
                <tr class="border-top">
                    <td class="text-end fw-bold">Grand Total:</td>
                    <td class="text-end fw-bold text-primary fs-6" id="lblGrandTotal">₹ 0.00</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="card p-3 mb-3">
        <label class="form-label fw-semibold">Narration / Remarks</label>
        <textarea asp-for="Narration" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
    </div>

    <div class="form-actions">
        <a href="/SaleOrder" class="btn btn-outline-secondary"><i class="bi bi-x me-1"></i>Cancel</a>
        <button type="submit" class="btn btn-primary fw-semibold" id="btnSubmitOrder"><i class="bi bi-send me-1"></i>Save Order</button>
    </div>
</form>

@section Scripts {
<script>
    var itemsList = []; // Array to store order items

    // Initialize list if editing an existing order or returning with validation errors
    @if (Model.Items != null && Model.Items.Count > 0)
    {
        foreach (var item in Model.Items)
        {
            <text>
            itemsList.push({
                stockItemId: @item.StockItemId,
                itemName: '@Html.Raw((item.ItemName ?? "").Replace("'", "\\'"))',
                uom: '@Html.Raw((item.UOM ?? "").Replace("'", "\\'"))',
                qty: @item.Qty,
                rate: @item.Rate,
                discount: @item.Discount,
                amount: @item.Amount,
                godownId: @(item.GodownId.HasValue ? item.GodownId.Value.ToString() : "null"),
                godownName: @Html.Raw(item.GodownName != null ? $"'{item.GodownName.Replace("'", "\\'")}'" : "null"),
                cgstRate: @item.CGSTRate,
                sgstRate: @item.SGSTRate,
                igstRate: @item.IGSTRate
            });
            </text>
        }
    }

    $(document).ready(function() {
        renderItemsTable();

        // AJAX form submission - prevents form from clearing
        $('#orderForm').on('submit', function(e) {
            e.preventDefault(); // Always prevent default form submission

            if (itemsList.length === 0) {
                showToast('danger', 'Please add at least one item to the order.', 'Validation Error');
                return false;
            }
            if ($('#ledgerIdInput').val() === '' || $('#ledgerIdInput').val() === '0') {
                showToast('danger', 'Please select a valid party / customer.', 'Validation Error');
                return false;
            }

            var $btn = $('#btnSubmitOrder');
            var originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Saving...');

            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: $(this).serialize(),
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function(response) {
                    if (response.success) {
                        // Show success popup overlay
                        showSuccessPopup(response.message, response.redirectUrl, @(Model.SaleOrderId > 0 ? "true" : "false"));
                    } else {
                        showToast('danger', response.message || 'Something went wrong. Please check the form.', 'Error');
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                },
                error: function(xhr) {
                    var msg = 'Server error. Please try again.';
                    try {
                        var resp = JSON.parse(xhr.responseText);
                        if (resp.message) msg = resp.message;
                    } catch(ex) {}
                    showToast('danger', msg, 'Error');
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });

            return false;
        });
    });

    // Party Search Autocomplete
    var partyTimer;
    $('#partySearch').on('input', function () {
        clearTimeout(partyTimer);
        var q = $(this).val();
        if (q.length < 1) { $('#partyDropdown').hide(); return; }
        partyTimer = setTimeout(() => {
            $.get('/SaleOrder/GetParties', { q }, function (data) {
                var dd = $('#partyDropdown').empty().show();
                if (!data.length) { 
                    dd.append('<div class="list-group-item list-group-item-action small text-muted py-2">No results found</div>'); 
                    return; 
                }
                data.forEach(p => {
                    // Built via the DOM API (.attr()/.text()), not a template
                    // string with the name spliced into an inline onclick —
                    // a party/item name containing an apostrophe (common:
                    // "O'Brien", "D'Souza") would break out of the JS string
                    // literal there and silently kill the click handler.
                    var $a = $('<a href="#" class="list-group-item list-group-item-action small py-2"></a>')
                        .attr('data-id', p.ledgerId)
                        .attr('data-name', p.ledgerName);
                    $('<div class="fw-semibold"></div>').text(p.ledgerName).appendTo($a);
                    $('<div class="text-muted" style="font-size:.75rem"></div>')
                        .text((p.mobileNo || '') + (p.balance ? ' · Bal: ₹' + p.balance.toFixed(2) : ''))
                        .appendTo($a);
                    dd.append($a);
                });
            });
        }, 300);
    });

    $('#partyDropdown').on('click', 'a', function (e) {
        e.preventDefault();
        var $t = $(this);
        selectParty($t.data('id'), $t.data('name'));
    });

    function selectParty(id, name) {
        $('#ledgerIdInput').val(id);
        $('#ledgerNameInput').val(name);
        $('#selectedPartyName').text(name);
        $('#selectedParty').show();
        $('#partySearchWrap').hide();
        $('#partyDropdown').hide();
    }

    function clearParty() {
        $('#ledgerIdInput').val('');
        $('#ledgerNameInput').val('');
        $('#selectedParty').hide();
        $('#partySearch').val('');
        $('#partySearchWrap').show();
    }

    // Item Search Autocomplete in Entry Row
    var itemTimer;
    $('#entryItemSearch').on('input', function () {
        clearTimeout(itemTimer);
        var q = $(this).val();
        if (q.length < 1) { $('#entryItemDropdown').hide(); return; }
        itemTimer = setTimeout(() => {
            $.get('/SaleOrder/GetItems', { q }, function (data) {
                var dd = $('#entryItemDropdown').empty().show();
                if (!data.length) { 
                    dd.append('<div class="list-group-item list-group-item-action small text-muted py-2">No results found</div>'); 
                    return; 
                }
                data.forEach(item => {
                    // See the party dropdown above for why this is built via
                    // the DOM API rather than an inline onclick string.
                    var $a = $('<a href="#" class="list-group-item list-group-item-action small py-2"></a>')
                        .attr('data-id', item.stockItemId)
                        .attr('data-name', item.itemName)
                        .attr('data-uom', item.uom)
                        .attr('data-rate', item.rate || 0);
                    $('<div class="fw-semibold"></div>').text(item.itemName).appendTo($a);
                    $('<div class="text-muted" style="font-size:.75rem"></div>')
                        .text('UOM: ' + item.uom + (item.rate ? ' · Rate: ₹' + item.rate.toFixed(2) : ''))
                        .appendTo($a);
                    if (item.remark) {
                        $('<div class="text-muted" style="font-size:.7rem"></div>')
                            .html('<i class="bi bi-box-seam me-1"></i>' + escHtml(item.remark))
                            .appendTo($a);
                    }
                    dd.append($a);
                });
            });
        }, 300);
    });

    $('#entryItemDropdown').on('click', 'a', function (e) {
        e.preventDefault();
        var $t = $(this);
        selectEntryItem($t.data('id'), $t.data('name'), $t.data('uom'), parseFloat($t.data('rate')) || 0);
    });

    function selectEntryItem(id, name, uom, masterRate) {
        $('#entryItemId').val(id);
        $('#entryItemName').val(name);
        $('#entryItemUOM').val(uom);
        $('#entryItemCGST, #entryItemSGST, #entryItemIGST').val(0);

        $('#entryItemSelectedName').text(name + ' (' + uom + ')');
        $('#entryItemSelectedLabel').show();
        $('#itemSearchWrap').hide();
        $('#entryItemDropdown').hide();

        // Fetch customer-specific last rate + this item's current GST% (as
        // of the order date) in one call; fall back to master rate on error.
        var ledgerId = $('#ledgerIdInput').val();
        var orderDate = $('#OrderDate').val();
        $.get('/SaleOrder/GetItemRate', { stockItemId: id, ledgerId: ledgerId || 0, orderDate: orderDate }, function(data) {
            var r = data.rate || 0;
            $('#entryRate').val(r > 0 ? r.toFixed(2) : (masterRate > 0 ? masterRate.toFixed(2) : ''));
            $('#entryItemCGST').val(data.cgstRate || 0);
            $('#entryItemSGST').val(data.sgstRate || 0);
            $('#entryItemIGST').val(data.igstRate || 0);
        }).fail(function() {
            if (masterRate > 0) $('#entryRate').val(masterRate.toFixed(2));
        });
        $('#entryQty').focus();
    }

    function clearEntryItem() {
        $('#entryItemId').val('');
        $('#entryItemName').val('');
        $('#entryItemUOM').val('');
        $('#entryItemCGST, #entryItemSGST, #entryItemIGST').val(0);
        $('#entryItemSearch').val('');
        $('#entryItemSelectedLabel').hide();
        $('#itemSearchWrap').show();
    }

    // Add or Update item in the table
    function addOrUpdateItem() {
        var itemId = $('#entryItemId').val();
        var itemName = $('#entryItemName').val();
        var uom = $('#entryItemUOM').val();
        var qty = parseFloat($('#entryQty').val());
        var rate = parseFloat($('#entryRate').val());
        var discount = parseFloat($('#entryDiscount').val());
        if (isNaN(discount)) discount = 0;

        // Validation
        if (!itemId || itemId === '') {
            showToast('danger', 'Please select a stock item.', 'Validation Error');
            return;
        }
        if (isNaN(qty) || qty <= 0) {
            showToast('danger', 'Quantity must be greater than 0.', 'Validation Error');
            $('#entryQty').focus();
            return;
        }
        if (isNaN(rate) || rate < 0) {
            showToast('danger', 'Rate cannot be negative.', 'Validation Error');
            $('#entryRate').focus();
            return;
        }
        if (discount < 0 || discount > 100) {
            showToast('danger', 'Discount must be between 0 and 100.', 'Validation Error');
            $('#entryDiscount').focus();
            return;
        }

        // Matches the server's own formula exactly (Controllers/SaleOrderController.cs:
        // item.Qty * item.Rate * (1 - item.Discount / 100)) — this is only a live preview,
        // the server always recomputes and trusts its own result on save.
        var amount = Math.round(qty * rate * (1 - discount / 100) * 100) / 100;

        var item = {
            stockItemId: parseInt(itemId),
            itemName: itemName,
            uom: uom,
            qty: qty,
            rate: rate,
            discount: discount,
            amount: amount,
            godownId: null,
            godownName: null,
            cgstRate: parseFloat($('#entryItemCGST').val()) || 0,
            sgstRate: parseFloat($('#entryItemSGST').val()) || 0,
            igstRate: parseFloat($('#entryItemIGST').val()) || 0
        };

        var editIdx = $('#editingIndex').val();
        if (editIdx !== '') {
            // Update mode
            itemsList[parseInt(editIdx)] = item;
            cancelEditItem();
        } else {
            // Same stock item can be added more than once as separate line
            // rows (e.g. different rate/batch for the same item on one
            // order) — no duplicate check here on purpose.
            itemsList.push(item);
            clearEntryFields();
        }

        renderItemsTable();
    }

    // Edit item from table
    function editItem(idx) {
        var item = itemsList[idx];
        
        $('#entryItemId').val(item.stockItemId);
        $('#entryItemName').val(item.itemName);
        $('#entryItemUOM').val(item.uom);
        $('#entryItemCGST').val(item.cgstRate || 0);
        $('#entryItemSGST').val(item.sgstRate || 0);
        $('#entryItemIGST').val(item.igstRate || 0);

        $('#entryItemSelectedName').text(item.itemName + ' (' + item.uom + ')');
        $('#entryItemSelectedLabel').show();
        $('#itemSearchWrap').hide();
        $('#entryItemDropdown').hide();

        $('#entryQty').val(item.qty);
        $('#entryRate').val(item.rate);
        $('#entryDiscount').val(item.discount || 0);

        $('#editingIndex').val(idx);
        $('#btnCancelEdit').show();
        $('#btnAddItem').html('<i class="bi bi-check-lg"></i> Save').removeClass('btn-primary').addClass('btn-success');
    }

    // Delete item from table
    function deleteItem(idx) {
        if (confirm('Are you sure you want to remove this item?')) {
            itemsList.splice(idx, 1);
            
            // If the deleted item was currently being edited, cancel edit mode
            var currentEditIdx = $('#editingIndex').val();
            if (currentEditIdx !== '' && parseInt(currentEditIdx) === idx) {
                cancelEditItem();
            } else if (currentEditIdx !== '' && parseInt(currentEditIdx) > idx) {
                // Adjust editing index if it shifted
                $('#editingIndex').val(parseInt(currentEditIdx) - 1);
            }

            renderItemsTable();
        }
    }

    function cancelEditItem() {
        clearEntryFields();
        $('#editingIndex').val('');
        $('#btnCancelEdit').hide();
        $('#btnAddItem').html('<i class="bi bi-plus-lg"></i> Add').removeClass('btn-success').addClass('btn-primary');
    }

    function clearEntryFields() {
        clearEntryItem();
        $('#entryQty').val('');
        $('#entryRate').val('');
        $('#entryDiscount').val('');
    }

    // Render items table dynamically with hidden input fields
    function renderItemsTable() {
        var tbody = $('#itemsTableBody').empty();
        var mobileContainer = $('#itemsMobileContainer').empty();
        var hiddenContainer = $('#hiddenItemsInputs').empty();
        var total = 0;
        
        if (itemsList.length === 0) {
            tbody.append('<tr><td colspan="7" class="text-center text-muted py-3">No items added yet. Please use the entry form above to add items.</td></tr>');
            mobileContainer.append('<div class="text-center text-muted py-3 bg-light rounded border border-dashed small">No items added yet. Please use the entry form above to add items.</div>');
            $('#grandTotalLabel').text('₹ 0.00');
            $('#grandTotalMobileCard').attr('style', 'display: none !important;');
            return;
        }
        
        $('#grandTotalMobileCard').attr('style', 'display: block !important;');
        
        itemsList.forEach((item, idx) => {
            var godownText = item.godownName ? ` · <span class="text-muted"><i class="bi bi-buildings"></i> ${escHtml(item.godownName)}</span>` : '';
            
            // 1. Desktop Table Row
            var row = `
            <tr>
                <td class="text-center fw-medium">${idx + 1}</td>
                <td>
                    <div class="fw-semibold">${escHtml(item.itemName)}</div>
                    <div class="text-muted" style="font-size: 0.75rem">${escHtml(item.uom)}${godownText}</div>
                </td>
                <td class="text-end">${item.qty.toFixed(3)}</td>
                <td class="text-end">₹ ${item.rate.toFixed(2)}</td>
                <td class="text-end">${(item.discount || 0).toFixed(2)}</td>
                <td class="text-end fw-semibold">₹ ${item.amount.toFixed(2)}</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-primary p-1 px-2 me-1" onclick="editItem(${idx})" title="Edit Item">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger p-1 px-2" onclick="deleteItem(${idx})" title="Delete Item">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>`;
            tbody.append(row);

            // 2. Mobile Card Item
            var mobileCard = `
            <div class="card mb-2 shadow-sm border border-light bg-white">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <div class="flex-grow-1">
                            <span class="badge bg-secondary me-2">#${idx + 1}</span>
                            <span class="fw-semibold text-dark fs-6" style="word-break: break-word;">${escHtml(item.itemName)}</span>
                            <div class="text-muted small mt-1" style="font-size: 0.8rem;">
                                <span><i class="bi bi-tag-fill me-1"></i> UOM: ${escHtml(item.uom)}</span>
                                ${item.godownName ? `<span class="ms-2"><i class="bi bi-buildings-fill me-1"></i> ${escHtml(item.godownName)}</span>` : ''}
                            </div>
                        </div>
                        <div class="d-flex gap-1 flex-shrink-0">
                            <button type="button" class="btn btn-sm btn-outline-primary p-1 px-2" onclick="editItem(${idx})" title="Edit Item">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger p-1 px-2" onclick="deleteItem(${idx})" title="Delete Item">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="row g-1 text-center bg-light p-2 rounded border border-light mt-2" style="font-size: 0.85rem;">
                        <div class="col-3 border-end">
                            <div class="text-muted small mb-1" style="font-size: 0.75rem;">Qty</div>
                            <div class="fw-bold">${item.qty.toFixed(3)}</div>
                        </div>
                        <div class="col-3 border-end">
                            <div class="text-muted small mb-1" style="font-size: 0.75rem;">Rate</div>
                            <div class="fw-semibold">₹${item.rate.toFixed(2)}</div>
                        </div>
                        <div class="col-3 border-end">
                            <div class="text-muted small mb-1" style="font-size: 0.75rem;">Disc%</div>
                            <div class="fw-semibold">${(item.discount || 0).toFixed(2)}</div>
                        </div>
                        <div class="col-3">
                            <div class="text-muted small mb-1" style="font-size: 0.75rem;">Amount</div>
                            <div class="fw-bold text-primary">₹${item.amount.toFixed(2)}</div>
                        </div>
                    </div>
                </div>
            </div>`;
            mobileContainer.append(mobileCard);

            // 3. Hidden Inputs for Model Binding
            var hiddenFields = `
            <input type="hidden" name="Items[${idx}].StockItemId" value="${item.stockItemId}" />
            <input type="hidden" name="Items[${idx}].ItemName" value="${escHtml(item.itemName)}" />
            <input type="hidden" name="Items[${idx}].UOM" value="${escHtml(item.uom)}" />
            <input type="hidden" name="Items[${idx}].Qty" value="${item.qty}" />
            <input type="hidden" name="Items[${idx}].Rate" value="${item.rate}" />
            <input type="hidden" name="Items[${idx}].Discount" value="${item.discount || 0}" />
            <input type="hidden" name="Items[${idx}].Amount" value="${item.amount}" />
            <input type="hidden" name="Items[${idx}].GodownId" value="${item.godownId || ''}" />
            <input type="hidden" name="Items[${idx}].GodownName" value="${escHtml(item.godownName || '')}" />`;
            hiddenContainer.append(hiddenFields);

            total += item.amount;
        });
        
        recalcTotals();
    }

    function escHtml(str) {
        return $('<div>').text(str || '').html();
    }

    function fmt(n) {
        return n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // Tax is now summed per line at that item's own CGST/SGST/IGST% (from
    // its Tally master data, fetched into itemsList[].cgstRate/etc when the
    // item was picked) rather than one flat rate applied to the whole
    // subtotal — this is purely a live preview for the user. The server
    // recomputes the same thing authoritatively from StockItemTaxSlabs on
    // save and ignores whatever these hidden fields carry.
    function recalcTotals() {
        var subtotal = itemsList.reduce(function(s, i) { return s + i.amount; }, 0);
        var taxType  = $('#taxTypeSelect').val() || 'None';

        var igstTotal = 0, cgstTotal = 0, sgstTotal = 0;
        itemsList.forEach(function(item) {
            if (taxType === 'IGST') {
                igstTotal += item.amount * (item.igstRate || 0) / 100;
            } else if (taxType === 'CGST_SGST') {
                cgstTotal += item.amount * (item.cgstRate || 0) / 100;
                sgstTotal += item.amount * (item.sgstRate || 0) / 100;
            }
        });
        igstTotal = Math.round(igstTotal * 100) / 100;
        cgstTotal = Math.round(cgstTotal * 100) / 100;
        sgstTotal = Math.round(sgstTotal * 100) / 100;
        var taxTotal = igstTotal + cgstTotal + sgstTotal;

        var rawGrand   = subtotal + taxTotal;
        var rounded    = Math.round(rawGrand);
        var roundOff   = Math.round((rounded - rawGrand) * 100) / 100;
        var grandTotal = rawGrand + roundOff;

        $('#lblSubTotal').text('₹ ' + fmt(subtotal));
        $('#grandTotalLabel').text('₹ ' + fmt(subtotal));
        $('#grandTotalLabelMobile').text('₹ ' + fmt(grandTotal));
        $('#lblGrandTotal').text('₹ ' + fmt(grandTotal));

        $('#rowIGST, #rowCGST, #rowSGST').hide();
        if (taxType === 'IGST' && igstTotal > 0) {
            $('#rowIGST').show();
            $('#lblIGSTLabel').text('IGST:');
            $('#lblIGSTAmt').text('₹ ' + fmt(igstTotal));
        } else if (taxType === 'CGST_SGST' && (cgstTotal > 0 || sgstTotal > 0)) {
            $('#rowCGST').show();
            $('#rowSGST').show();
            $('#lblCGSTLabel').text('CGST:');
            $('#lblSGSTLabel').text('SGST:');
            $('#lblCGSTAmt').text('₹ ' + fmt(cgstTotal));
            $('#lblSGSTAmt').text('₹ ' + fmt(sgstTotal));
        }

        if (roundOff !== 0) {
            $('#rowRoundOff').show();
            $('#lblRoundOff').text((roundOff >= 0 ? '₹ ' : '- ₹ ') + fmt(Math.abs(roundOff)));
        } else {
            $('#rowRoundOff').hide();
        }

        // Update hidden inputs for form submission (informational only —
        // the server ignores these and recomputes from scratch)
        $('#hidTaxType').val(taxType);
        $('#hidTaxPercent').val(subtotal > 0 ? Math.round(taxTotal / subtotal * 10000) / 100 : 0);
        $('#hidTaxTotal').val(taxTotal);
        $('#hidRoundOff').val(roundOff);
        $('#hidGrandTotal').val(grandTotal);
    }

    // Close autocomplete dropdowns when clicking outside
    $(document).on('click', function (e) {
        if (!$(e.target).closest('#partySearch, #partyDropdown').length) $('#partyDropdown').hide();
        if (!$(e.target).closest('#entryItemSearch, #entryItemDropdown').length) $('#entryItemDropdown').hide();
    });

    @if (Model.LedgerId > 0)
    {
        <text>selectParty(@Model.LedgerId, '@Html.Raw((Model.LedgerName ?? "").Replace("'", "\\'"))');</text>
    }

    // For edits: override the default TaxType with the order's saved value
    @if (Model.SaleOrderId > 0 && Model.TaxType != "None")
    {
        <text>
        $('#taxTypeSelect').val('@Model.TaxType');
        </text>
    }
    recalcTotals();

    // Success popup with animated overlay and redirect
    function showSuccessPopup(message, redirectUrl, isEdit) {
        var title = isEdit ? 'Order Updated!' : 'Order Created!';
        // Create overlay
        var overlay = $(`
            <div id="successOverlay" style="
                position: fixed; top: 0; left: 0; right: 0; bottom: 0;
                background: rgba(0,0,0,0.5); z-index: 99999;
                display: flex; align-items: center; justify-content: center;
                animation: fadeIn 0.3s ease;
            ">
                <div style="
                    background: white; border-radius: 16px; padding: 40px 32px;
                    text-align: center; max-width: 400px; width: 90%;
                    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
                    animation: popIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                ">
                    <div style="
                        width: 80px; height: 80px; border-radius: 50%;
                        background: linear-gradient(135deg, #28a745, #20c997);
                        display: flex; align-items: center; justify-content: center;
                        margin: 0 auto 20px; animation: scaleIn 0.5s ease 0.2s both;
                    ">
                        <i class="bi bi-check-lg" style="font-size: 40px; color: white;"></i>
                    </div>
                    <h4 style="color: #333; margin-bottom: 8px; font-weight: 700;">${title}</h4>
                    <p style="color: #666; margin-bottom: 20px; font-size: 0.95rem;">${message}</p>
                    <div style="color: #999; font-size: 0.85rem;">
                        <span class="spinner-border spinner-border-sm me-1"></span> Redirecting to Dashboard...
                    </div>
                </div>
            </div>
        `);

        // Add animation styles
        if (!$('#successPopupStyles').length) {
            $('head').append(`
                <style id="successPopupStyles">
                    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
                    @@keyframes popIn { from { opacity: 0; transform: scale(0.8) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }
                    @@keyframes scaleIn { from { transform: scale(0); } to { transform: scale(1); } }
                </style>
            `);
        }

        $('body').append(overlay);

        // Redirect after delay
        setTimeout(function() {
            window.location.href = redirectUrl || '/Dashboard';
        }, 1500);
    }
</script>
}
