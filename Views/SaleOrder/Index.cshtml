@model IEnumerable<SaleOrd.Models.ViewModels.SaleOrderListVM>
@{ ViewData["Title"] = "Sale Orders"; ViewData["ActivePage"] = "Orders"; }

<div class="page-header">
    <h5>Sale Orders</h5>
    <a href="/SaleOrder/Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New</a>
</div>

<!-- Filter bar -->
<div class="row g-2 mb-3">
    <div class="col-8 col-md-5">
        <div class="input-group input-group-sm">
            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="searchInput" class="form-control form-control-sm"
                   placeholder="Search party / order no..." autocomplete="off" />
            <button type="button" id="btnClear" class="btn btn-outline-secondary" style="display:none" onclick="clearSearch()">
                <i class="bi bi-x"></i>
            </button>
        </div>
    </div>
    <div class="col-4 col-md-3">
        <select id="statusFilter" class="form-select form-select-sm">
            <option value="">All Status</option>
            @foreach (var s in new[] { "Cancelled", "Pending", "Synced", "Error" })
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div id="searchStatus" class="col-auto d-flex align-items-center text-muted small"></div>
</div>

<div id="orderResults">
    @foreach (var o in Model)
    {
        string statusClass = o.Status.ToString() switch
        {
            "Pending" => "badge-pending",
            "Synced"  => "badge-synced",
            "Error"   => "badge-error",
            _         => "badge-cancelled"
        };
        <a href="/SaleOrder/Details/@o.SaleOrderId" class="text-decoration-none">
            <div class="order-card card px-3 py-2">
                <div class="d-flex justify-content-between align-items-center">
                    <div style="min-width:0">
                        <div class="fw-semibold text-truncate">@o.LedgerName</div>
                        <div class="small text-muted">@o.OrderNo · @o.OrderDate.ToString("dd MMM yyyy")</div>
                        @if (o.Status.ToString() == "Error" && !string.IsNullOrEmpty(o.SyncError))
                        {
                            <div class="small text-danger text-truncate">@o.SyncError</div>
                        }
                    </div>
                    <div class="text-end ms-2 flex-shrink-0">
                        <div class="fw-bold">₹ @o.TotalAmount.ToString("N0")</div>
                        <span class="badge @statusClass" style="font-size:.7rem">@o.Status</span>
                    </div>
                </div>
            </div>
        </a>
    }
    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-file-earmark-x" style="font-size:36px"></i>
            <p class="mt-2 small">No orders found.</p>
        </div>
    }
</div>

@if ((int)ViewBag.Total > (int)ViewBag.PageSize)
{
    var pgNum = (int)ViewBag.Page;
    var pgTotal = (int)ViewBag.Total;
    var pgSize = (int)ViewBag.PageSize;
    var pgCount = (int)Math.Ceiling((double)pgTotal / pgSize);
    var prevUrl = Url.Action("Index", new { page = pgNum - 1, status = ViewBag.Status, search = ViewBag.Search });
    var nextUrl = Url.Action("Index", new { page = pgNum + 1, status = ViewBag.Status, search = ViewBag.Search });
    <nav id="staticPagination" class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @if (pgNum > 1)
            {
                <li class="page-item"><a class="page-link" href="@prevUrl">Prev</a></li>
            }
            <li class="page-item disabled"><span class="page-link">@pgNum / @pgCount</span></li>
            @if (pgNum < pgCount)
            {
                <li class="page-item"><a class="page-link" href="@nextUrl">Next</a></li>
            }
        </ul>
    </nav>
}

@section Scripts {
<script>
var searchTimer;
var activeQ = '';
var activeStatus = '';
var defaultHtml = '';
var hasPagination = @Html.Raw((int)ViewBag.Total > (int)ViewBag.PageSize ? "true" : "false");

$(function() {
    defaultHtml = $('#orderResults').html();
});

$('#searchInput').on('input', function() {
    clearTimeout(searchTimer);
    var q = this.value.trim();
    $('#btnClear').toggle(q.length > 0);
    activeQ = q;
    searchTimer = setTimeout(doSearch, 280);
});

$('#statusFilter').on('change', function() {
    activeStatus = this.value;
    clearTimeout(searchTimer);
    doSearch();
});

function doSearch() {
    if (activeQ === '' && activeStatus === '') {
        restoreDefault();
        return;
    }
    $('#orderResults').html('<div class="text-center py-4 text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Searching...</div>');
    $('#staticPagination').hide();
    $.get('/SaleOrder/OrdersSearch', { q: activeQ, status: activeStatus }, function(data) {
        renderOrders(data);
    }).fail(function() {
        $('#orderResults').html('<div class="alert alert-danger">Search failed. Please try again.</div>');
    });
}

function renderOrders(orders) {
    if (!orders.length) {
        $('#searchStatus').text('');
        $('#orderResults').html(
            '<div class="text-center text-muted py-5">' +
            '<i class="bi bi-file-earmark-x" style="font-size:36px"></i>' +
            '<p class="mt-2 small">No orders found.</p></div>');
        return;
    }

    var count = orders.length;
    $('#searchStatus').text(count === 50 ? '50+ results' : count + ' result' + (count > 1 ? 's' : ''));

    var html = '';
    var statusClasses = { Cancelled: 'badge-cancelled', Pending: 'badge-pending', Synced: 'badge-synced', Error: 'badge-error' };
    orders.forEach(function(o) {
        var sc = statusClasses[o.status] || 'badge-cancelled';
        var errorHtml = (o.status === 'Error' && o.syncError)
            ? '<div class="small text-danger text-truncate">' + esc(o.syncError) + '</div>' : '';
        html += '<a href="/SaleOrder/Details/' + o.saleOrderId + '" class="text-decoration-none">' +
            '<div class="order-card card px-3 py-2">' +
            '<div class="d-flex justify-content-between align-items-center">' +
            '<div style="min-width:0">' +
            '<div class="fw-semibold text-truncate">' + esc(o.ledgerName) + '</div>' +
            '<div class="small text-muted">' + esc(o.orderNo) + ' · ' + esc(o.orderDate) + '</div>' +
            errorHtml +
            '</div>' +
            '<div class="text-end ms-2 flex-shrink-0">' +
            '<div class="fw-bold">&#8377; ' + fmt(o.totalAmount) + '</div>' +
            '<span class="badge ' + sc + '" style="font-size:.7rem">' + esc(o.status) + '</span>' +
            '</div></div></div></a>';
    });
    if (count === 50) html += '<div class="text-muted small text-center mt-2 py-2">Showing top 50 — refine your search</div>';
    $('#orderResults').html(html);
}

function restoreDefault() {
    $('#searchStatus').text('');
    $('#orderResults').html(defaultHtml);
    if (hasPagination) $('#staticPagination').show();
}

function clearSearch() {
    $('#searchInput').val('').focus();
    $('#btnClear').hide();
    activeQ = '';
    if (activeStatus === '') restoreDefault();
    else doSearch();
}

function esc(s) { var d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }
function fmt(n) { return (n || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 }); }
</script>
}
