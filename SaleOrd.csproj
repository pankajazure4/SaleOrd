<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- SaleOrd.SyncAgent is a separate WinForms project nested in this folder
         (sibling projects in this dev environment live under a shared parent
         rather than actually side-by-side) — exclude it from this project's
         default glob so its System.Windows.Forms code doesn't get compiled
         into the ASP.NET Core web app. -->
    <Compile Remove="SaleOrd.SyncAgent\**\*.cs" />
    <None Remove="SaleOrd.SyncAgent\**" />
    <Content Remove="SaleOrd.SyncAgent\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
