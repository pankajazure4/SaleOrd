<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>True</UseWindowsForms>
    <ApplicationIcon>agent.ico</ApplicationIcon>
    <AssemblyTitle>SalesPush Sync Agent</AssemblyTitle>
    <Product>SalesPush Sync Agent</Product>
    <Company>SaleOrd</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>

    <!-- Microsoft.Data.SqlClient ships a native SNI.dll that isn't embedded
         into the single-file exe by default — without this, TdsParser's
         static constructor fails to load it at runtime, surfacing as
         "The type initializer for 'Microsoft.Data.SqlClient.TdsParser'
         threw an exception" the moment any SqlConnection is opened (Test
         Connection). This tells the self-contained single-file publish to
         extract native libraries alongside the exe so SNI.dll is actually
         there to load. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Net.Http.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="agent.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
